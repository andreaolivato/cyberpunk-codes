      "root": {
        "HandleId": "0",
        "Data": {
          "$type": "localizationPersistenceSubtitleEntries",
          "entries": [
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "J\u0027ai besoin de quelqu\u0027un de discret pour une op\u00E9ration \u00E9clair.",
              "maleVariant": "J\u0027ai besoin de quelqu\u0027un de discret pour une op\u00E9ration \u00E9clair.",
              "stringId": "2436829434735086876"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "C\u0027est pour moi, il n\u0027y a pas de client, alors fais \u00E7a vite, et fais \u00E7a bien.",
              "maleVariant": "C\u0027est pour moi, il n\u0027y a pas de client, alors fais \u00E7a vite, et fais \u00E7a bien.",
              "stringId": "2436830534246715087"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Listen.",
              "maleVariant": "Listen.",
              "stringId": "3120035173233574268"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Tu es la seule en qui j\u0027ai assez confiance.",
              "maleVariant": "Tu es le seul en qui j\u0027ai assez confiance.",
              "stringId": "2436832733269971509"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Heh. They didn\u0027t even make it out of the car.",
              "maleVariant": "Heh. They didn\u0027t even make it out of the car.",
              "stringId": "2779393658226020611"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Shotgun through the glass.",
              "maleVariant": "Shotgun through the glass.",
              "stringId": "2779407951877187354"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Pow!",
              "maleVariant": "Pow!",
              "stringId": "2593271555036156136"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "maleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "stringId": "2779409051388815565"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Ugh!",
              "maleVariant": "Ugh!",
              "stringId": "2790588562204666796"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! Wait! Why?",
              "maleVariant": "No! Wait! Why?",
              "stringId": "2789606698320863598"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Wakako? She hired me!",
              "maleVariant": "Wakako? She hired me!",
              "stringId": "2789607797832491809"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "maleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "stringId": "2789604499297607176"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Look for yourself.",
              "maleVariant": "Look for yourself.",
              "stringId": "2789605598809235387"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Finish it.",
              "maleVariant": "Finish it.",
              "stringId": "2420173659152984664"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Let him go.",
              "maleVariant": "Let him go.",
              "stringId": "2420174758664612875"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Connect.",
              "maleVariant": "Connect.",
              "stringId": "3315287305784286272"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Hand it over.",
              "maleVariant": "Hand it over.",
              "stringId": "3093055499208003535"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nova.",
              "maleVariant": "Nova.",
              "stringId": "2810295193057016356"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Give me half an hour. I\u0027ll message you.",
              "maleVariant": "Give me half an hour. I\u0027ll message you.",
              "stringId": "2810298491591900989"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Good, you\u0027re in. There\u0027s a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "maleVariant": "Good, you\u0027re in. There\u0027s a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "stringId": "3156708257209297834"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Jack in, breach it, and send me everything it\u0027s been carrying.",
              "maleVariant": "Jack in, breach it, and send me everything it\u0027s been carrying.",
              "stringId": "3155708801139443260"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Share what you found with Wakako.",
              "maleVariant": "Share what you found with Wakako.",
              "stringId": "2396304581542984411"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Parle, alors.",
              "maleVariant": "Parle, alors.",
              "stringId": "2841961933719189729"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Show her Char\u0027s trace.",
              "maleVariant": "Show her Char\u0027s trace.",
              "stringId": "2395321618147553002"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Il a d\u00FB lui arriver quelque chose. Il n\u0027oserait pas me d\u00E9sob\u00E9ir.",
              "maleVariant": "Il a d\u00FB lui arriver quelque chose. Il n\u0027oserait pas me d\u00E9sob\u00E9ir.",
              "stringId": "2841964132742446151"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Discret et tout en finesse.",
              "maleVariant": "Discret et tout en finesse.",
              "stringId": "2842954792719275037"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Un vrai fant\u00F4me.",
              "maleVariant": "Un vrai fant\u00F4me.",
              "stringId": "3423925640042202332"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Tu devais faire \u00E7a discr\u00E8tement. Quel fiasco\u00A0!",
              "maleVariant": "Tu devais faire \u00E7a discr\u00E8tement. Quel fiasco\u00A0!",
              "stringId": "3408739870859945416"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Lean on the railing and wait for Char.",
              "maleVariant": "Lean on the railing and wait for Char.",
              "stringId": "3327307582760467917"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Sit down and wait for Char.",
              "maleVariant": "Sit down and wait for Char.",
              "stringId": "2623302448557323786"
            }
          ]
        }
      }
