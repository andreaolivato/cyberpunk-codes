        "Data": {
          "$type": "localizationPersistenceSubtitleEntries",
          "entries": [
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0434\u043B\u044F \u0442\u0438\u0445\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B.",
              "maleVariant": "\u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0434\u043B\u044F \u0442\u0438\u0445\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B.",
              "stringId": "2436829434735086876"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u0418\u043C\u0435\u043D\u043D\u043E \u043C\u043D\u0435, \u043D\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u0443, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u0442\u043D\u0435\u0441\u0438\u0441\u044C \u043A \u0440\u0430\u0431\u043E\u0442\u0435 \u0441\u043E \u0432\u0441\u0435\u0439 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0441\u0442\u044C\u044E.",
              "maleVariant": "\u0418\u043C\u0435\u043D\u043D\u043E \u043C\u043D\u0435, \u043D\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u0443, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u0442\u043D\u0435\u0441\u0438\u0441\u044C \u043A \u0440\u0430\u0431\u043E\u0442\u0435 \u0441\u043E \u0432\u0441\u0435\u0439 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0441\u0442\u044C\u044E.",
              "stringId": "2436830534246715087"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Listen.",
              "maleVariant": "Listen.",
              "stringId": "3120035173233574268"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u041A\u0440\u043E\u043C\u0435 \u0442\u0435\u0431\u044F, \u0441 \u043D\u0438\u043C \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u0441\u044F.",
              "maleVariant": "\u041A\u0440\u043E\u043C\u0435 \u0442\u0435\u0431\u044F, \u0441 \u043D\u0438\u043C \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u0441\u044F.",
              "stringId": "2436832733269971509"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Heh. They didn\u0027t even make it out of the car.",
              "maleVariant": "Heh. They didn\u0027t even make it out of the car.",
              "stringId": "2779393658226020611"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Shotgun through the glass.",
              "maleVariant": "Shotgun through the glass.",
              "stringId": "2779407951877187354"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Pow!",
              "maleVariant": "Pow!",
              "stringId": "2593271555036156136"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "maleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "stringId": "2779409051388815565"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Ugh!",
              "maleVariant": "Ugh!",
              "stringId": "2790588562204666796"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! Wait! Why?",
              "maleVariant": "No! Wait! Why?",
              "stringId": "2789606698320863598"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Wakako? She hired me!",
              "maleVariant": "Wakako? She hired me!",
              "stringId": "2789607797832491809"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "maleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "stringId": "2789604499297607176"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Look for yourself.",
              "maleVariant": "Look for yourself.",
              "stringId": "2789605598809235387"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Finish it.",
              "maleVariant": "Finish it.",
              "stringId": "2420173659152984664"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Let him go.",
              "maleVariant": "Let him go.",
              "stringId": "2420174758664612875"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Connect.",
              "maleVariant": "Connect.",
              "stringId": "3315287305784286272"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Hand it over.",
              "maleVariant": "Hand it over.",
              "stringId": "3093055499208003535"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nova.",
              "maleVariant": "Nova.",
              "stringId": "2810295193057016356"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Give me half an hour. I\u0027ll message you.",
              "maleVariant": "Give me half an hour. I\u0027ll message you.",
              "stringId": "2810298491591900989"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Good, you\u0027re in. There\u0027s a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "maleVariant": "Good, you\u0027re in. There\u0027s a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "stringId": "3156708257209297834"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Jack in, breach it, and send me everything it\u0027s been carrying.",
              "maleVariant": "Jack in, breach it, and send me everything it\u0027s been carrying.",
              "stringId": "3155708801139443260"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Share what you found with Wakako.",
              "maleVariant": "Share what you found with Wakako.",
              "stringId": "2396304581542984411"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u041D\u0443 \u0445\u043E\u0440\u043E\u0448\u043E.",
              "maleVariant": "\u041D\u0443 \u0445\u043E\u0440\u043E\u0448\u043E.",
              "stringId": "2841961933719189729"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Show her Char\u0027s trace.",
              "maleVariant": "Show her Char\u0027s trace.",
              "stringId": "2395321618147553002"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u0421\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u0447\u0442\u043E-\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C. \u041E\u043D \u0431\u044B \u043D\u0435 \u043F\u043E\u0441\u043C\u0435\u043B \u043F\u043E\u0439\u0442\u0438 \u043F\u0440\u043E\u0442\u0438\u0432 \u043C\u0435\u043D\u044F.",
              "maleVariant": "\u0421\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u0447\u0442\u043E-\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C. \u041E\u043D \u0431\u044B \u043D\u0435 \u043F\u043E\u0441\u043C\u0435\u043B \u043F\u043E\u0439\u0442\u0438 \u043F\u0440\u043E\u0442\u0438\u0432 \u043C\u0435\u043D\u044F.",
              "stringId": "2841964132742446151"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u041A\u0440\u0430\u0441\u0438\u0432\u043E \u0438 \u0442\u0438\u0445\u043E.",
              "maleVariant": "\u041A\u0440\u0430\u0441\u0438\u0432\u043E \u0438 \u0442\u0438\u0445\u043E.",
              "stringId": "2842954792719275037"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u0422\u044B \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u0438 \u0438\u0441\u0447\u0435\u0437\u043B\u0430, \u043A\u0430\u043A \u0434\u0443\u0445, \u0412\u0438.",
              "maleVariant": "\u0422\u044B \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0438 \u0438\u0441\u0447\u0435\u0437, \u043A\u0430\u043A \u0434\u0443\u0445, \u0412\u0438.",
              "stringId": "3423925640042202332"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u041D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0451 \u0442\u0438\u0445\u043E, \u0430 \u0442\u0438\u0445\u043E \u043D\u0435 \u0431\u044B\u043B\u043E.",
              "maleVariant": "\u041D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0451 \u0442\u0438\u0445\u043E, \u0430 \u0442\u0438\u0445\u043E \u043D\u0435 \u0431\u044B\u043B\u043E.",
              "stringId": "3408739870859945416"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Lean on the railing and wait for Char.",
              "maleVariant": "Lean on the railing and wait for Char.",
              "stringId": "3327307582760467917"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Sit down and wait for Char.",
              "maleVariant": "Sit down and wait for Char.",
              "stringId": "2623302448557323786"
            }
          ]
        }
