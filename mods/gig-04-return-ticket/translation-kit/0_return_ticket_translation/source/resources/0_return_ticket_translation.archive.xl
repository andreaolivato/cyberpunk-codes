# Translation of Return Ticket. Replace <lang> below with your language's code, in
# every line it appears on. The codes are: it-it, de-de, fr-fr, es-es, es-mx, pl-pl, ru-ru, pt-br, jp-jp, kr-kr, zh-cn, zh-tw, cz-cz, hu-hu, ar-ar, th-th, tr-tr, ua-ua.
localization:
  onscreens:
    <lang>:
      - mod\return_ticket_translation\strings.json
  subtitles:
    <lang>: mod\return_ticket_translation\subtitles.json
  # Only if you recorded Hodan, Maricel, Stamps and Reynaldo in your language, and only once every
  # clip is in place (optional-voice/README.md):
  # vomaps:
  #   <lang>: mod\return_ticket_translation\vomap.json
