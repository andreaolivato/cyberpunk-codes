{
 "gig04_beaten/stamps": {
  "f_22EA59083FE9646E": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_beaten__s09.wem",
   "audio_sha256": "3491a081196b0873a4e08ef26ce38b75993113731a06d93e4ea38bc55ce5f399",
   "key": "s09",
   "text": "Stop! Stop! Okay!"
  },
  "f_2D885304998689CB": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_beaten__s06f.wem",
   "audio_sha256": "b44a6399d6de8ebef32db87659c7155397982862dfdad2d5911793865e681f5b",
   "key": "s06f",
   "text": "Orbital Air's coming for him. You've got a few hours."
  },
  "f_2D8C4104998A540C": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_beaten__s05f.wem",
   "audio_sha256": "a5dce7bd3f05a4fef0088f2db1d4c291dc6a18d71814cc839c875d9a06c9967c",
   "key": "s05f",
   "text": "The Claws are keeping him in their van. Back of a yard in south Little China."
  }
 },
 "gig04_booth/stamps": {
  "f_23D553F8D84B3762": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s08.wem",
   "audio_sha256": "8a87272230065417f0a821bac922286e93d0bfb90dca69306e3e5649437791ec",
   "key": "s08",
   "text": "Warsame. Her people pay on time. Fine."
  },
  "f_23D555F8D84B3AC8": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s06.wem",
   "audio_sha256": "b44a6399d6de8ebef32db87659c7155397982862dfdad2d5911793865e681f5b",
   "key": "s06",
   "text": "Orbital Air's coming for him. You've got a few hours."
  },
  "f_23D556F8D84B3C7B": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s07.wem",
   "audio_sha256": "d64d508d26f1be90aa4582d869c72f4ebb40fafe69db69a09628dc8131bcf10a",
   "key": "s07",
   "text": "Okay! Okay. Hands where I can see them."
  },
  "f_23D557F8D84B3E2E": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s04.wem",
   "audio_sha256": "90229409701d61e9a8d79f0e8f5bdfcc63dd0c3d54ef9a2a599454d22a4ee523",
   "key": "s04",
   "text": "Pleasure."
  },
  "f_23D558F8D84B3FE1": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s05.wem",
   "audio_sha256": "a5dce7bd3f05a4fef0088f2db1d4c291dc6a18d71814cc839c875d9a06c9967c",
   "key": "s05",
   "text": "The Claws are keeping him in their van. Back of a yard in south Little China."
  },
  "f_23D559F8D84B4194": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s02.wem",
   "audio_sha256": "b418571a5d4f2850dc1aae1837b2035db14f6eec0cabfea29714dd5c550c0296",
   "key": "s02",
   "text": "I ask everybody who they're running from. He said Orbital Air. Orbital Air paid better for a tip."
  },
  "f_23D55AF8D84B4347": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s03.wem",
   "audio_sha256": "407932f9c28232011e3465f073623c2c018b7ebf1e8138cb210f20647f49f6bf",
   "key": "s03",
   "text": "They paid me already. I got nothing to lose telling you. But I don't tell for free."
  },
  "f_23D55CF8D84B46AD": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s01.wem",
   "audio_sha256": "184a37b36a11efbd62d4f3efdcfa61fb729e02b77defc7469345eca1feb59807",
   "key": "s01",
   "text": "Ah, the janitor. He wanted a new name."
  },
  "f_2EBBB6D787D49F93": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s06i.wem",
   "audio_sha256": "b44a6399d6de8ebef32db87659c7155397982862dfdad2d5911793865e681f5b",
   "key": "s06i",
   "text": "Orbital Air's coming for him. You've got a few hours."
  },
  "f_2EBBD1D787D4CD74": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s06t.wem",
   "audio_sha256": "b44a6399d6de8ebef32db87659c7155397982862dfdad2d5911793865e681f5b",
   "key": "s06t",
   "text": "Orbital Air's coming for him. You've got a few hours."
  },
  "f_2EC5B6D787DCF418": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s05i.wem",
   "audio_sha256": "a5dce7bd3f05a4fef0088f2db1d4c291dc6a18d71814cc839c875d9a06c9967c",
   "key": "s05i",
   "text": "The Claws are keeping him in their van. Back of a yard in south Little China."
  },
  "f_2EC5C3D787DD0A2F": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_booth__s05t.wem",
   "audio_sha256": "a5dce7bd3f05a4fef0088f2db1d4c291dc6a18d71814cc839c875d9a06c9967c",
   "key": "s05t",
   "text": "The Claws are keeping him in their van. Back of a yard in south Little China."
  }
 },
 "gig04_brief/hodan": {
  "f_20BC6EFF9C176F16": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_brief__c04.wem",
   "audio_sha256": "95a7ed025c4a4b32271e5c051d5eee8f0985f350fade47bf2d909362b5deecd7",
   "key": "c04",
   "text": "My friend sent his sister to me. She's the client. Talk to her. Details attached."
  },
  "f_20BC70FF9C17727C": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_brief__c02.wem",
   "audio_sha256": "bc2da4b5c7b27ac6c93809668efaf0b8ada5d8a8c9d30378012d08cedd332c69",
   "key": "c02",
   "text": "Reynaldo Manalo. He cleaned rooms on an Orbital Air station. They charged him for the flight up, the bed he slept in, even the scraps of food he ate."
  },
  "f_20BC71FF9C17742F": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_brief__c03.wem",
   "audio_sha256": "3f76d17871772861d0c5518f2df729d449afbb2836914929a88cc1a3a0b91c24",
   "key": "c03",
   "text": "Nobody knows. They took him from his sister's stall in the market."
  },
  "f_20BC73FF9C177795": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_brief__c01.wem",
   "audio_sha256": "cc6d1a6cc58d41210b0ee40e72a523a45baf63169d7c06d07caf6714acdd1909",
   "key": "c01",
   "text": "V, I got a job for you. There's a man in Kabuki. The Tyger Claws took him last night."
  },
  "f_27A620563BD6E8FA": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_brief__c02b.wem",
   "audio_sha256": "400292df6f4576d1b904b8b984ae1748dc4ef3f54708b54bf1dabb1fc6a87dc3",
   "key": "c02b",
   "text": "After seven years of painful work, he owed more than the day he signed up. So he ran."
  },
  "f_27A621563BD6EAAD": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_brief__c02c.wem",
   "audio_sha256": "c7020cc43138415d89e01bb742e42fd54be6c3f98529f78257de4a60c905919b",
   "key": "c02c",
   "text": "An old friend of mine, Liban, got him down to Night City. Somebody here sold him out."
  }
 },
 "gig04_bye/bayani": {
  "f_283F1118C3A9D38B": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_bye__b06.wem",
   "audio_sha256": "2565f33e92014f85a3a6fead3ccc2420af1f76ff17fc52ecd6df762a0f13454b",
   "key": "b06",
   "text": "I'm going to say goodbye to Maricel. Then I'm gone."
  },
  "f_283F1218C3A9D53E": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_bye__b05.wem",
   "audio_sha256": "760e637d00b611067e0748cdaffc049bfdc1236b3ca6822307a642b39d232349",
   "key": "b05",
   "text": "Thank you. I thought I'd be back in that hell by morning."
  }
 },
 "gig04_close/hodan": {
  "f_26BC5B9CC3CCA017": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_close__e01b.wem",
   "audio_sha256": "9953780eb95ad7fb78d48bf5c2a6f9fc3648e4f8d3271c4d46b9b55009d19a81",
   "key": "e01b",
   "text": "My friend drove him out tonight."
  },
  "f_2C5AE22ABB984E6F": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_close__e01.wem",
   "audio_sha256": "9503868c3888d325cbc7c495e19174b7da8a9c0374aafd54e99b2e2b545e010f",
   "key": "e01",
   "text": "His sister called. He's out of Night City."
  },
  "f_2C5AE42ABB9851D5": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_close__e03.wem",
   "audio_sha256": "89e9a70bb624291a13a40e1f642e05f4e599de06bc4e0427804e50a30571204e",
   "key": "e03",
   "text": "Well done, V. Your fee will be in your account shortly. Take care."
  }
 },
 "gig04_close_dead/hodan": {
  "f_24860BDC931B7C66": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_close_dead__e01b.wem",
   "audio_sha256": "9953780eb95ad7fb78d48bf5c2a6f9fc3648e4f8d3271c4d46b9b55009d19a81",
   "key": "e01b",
   "text": "My friend drove him out tonight."
  },
  "f_2CCF61B6F1A02360": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_close_dead__e01.wem",
   "audio_sha256": "9503868c3888d325cbc7c495e19174b7da8a9c0374aafd54e99b2e2b545e010f",
   "key": "e01",
   "text": "His sister called. He's out of Night City."
  },
  "f_2CCF63B6F1A026C6": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_close_dead__e03.wem",
   "audio_sha256": "89e9a70bb624291a13a40e1f642e05f4e599de06bc4e0427804e50a30571204e",
   "key": "e03",
   "text": "Well done, V. Your fee will be in your account shortly. Take care."
  },
  "f_2CCF64B6F1A02879": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_close_dead__e02.wem",
   "audio_sha256": "91c72454371d140f345f7a073194c5ceabd1483c71c769aed4c211f987e8e3df",
   "key": "e02",
   "text": "Stamps is dead. Maricel still has to live in that market."
  }
 },
 "gig04_room/bayani": {
  "f_2751555DF42BED16": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_room__b04.wem",
   "audio_sha256": "0f11854f60eff98ba3fd8714486fff8c82dd717e7f2d6248189126c05443df4b",
   "key": "b04",
   "text": "I'm not going back up."
  },
  "f_2751575DF42BF07C": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_room__b02.wem",
   "audio_sha256": "8e4f402b5f224cdf03f0eb28f0f378bdd84173161e7b2ae209b8cd04a00bc608",
   "key": "b02",
   "text": "Yes. I can walk."
  },
  "f_2751585DF42BF22F": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_room__b03.wem",
   "audio_sha256": "a3ad69de7f11a7f4b0de7e44a32d177ecfb26272dcf62770b40ec5b4e90ecea9",
   "key": "b03",
   "text": "Seven years up there. I owed more at the end than the day I signed."
  },
  "f_27515A5DF42BF595": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_room__b01.wem",
   "audio_sha256": "3783bf3952d1139048b4e6ba0338c01c54a1393a8f49636955e124ee84b2f414",
   "key": "b01",
   "text": "Who are you? Did Maricel send you?"
  }
 },
 "gig04_stall/ligaya": {
  "f_221634911ACD7870": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_stall__l03.wem",
   "audio_sha256": "47d39e7e695c6af38223a9542cf17f54f7f7109b569075e6e31f784fe42c8079",
   "key": "l03",
   "text": "Two Tyger Claws came last night. They knew his name. They took him out the back."
  },
  "f_221635911ACD7A23": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_stall__l02.wem",
   "audio_sha256": "805d05f6fe7ce42cb2dfa2beed9b7772edf9e5d21fb25792819ce23a4df1162f",
   "key": "l02",
   "text": "Reynaldo, Rey, is my brother. He came here three nights ago. I hadn't seen him in seven years."
  },
  "f_221636911ACD7BD6": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_stall__l01.wem",
   "audio_sha256": "72b7d5dbfc2a16f631d54dfef75bb07803aad921aa33d1e89c654e8a2ea36738",
   "key": "l01",
   "text": "Ay, Liban said she'd send somebody. Don't talk so loud."
  },
  "f_221639911ACD80EF": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_stall__l06.wem",
   "audio_sha256": "173cacc738b82d64ae5ef0aceeaf30da8daae0dcbf1dcb17798344bc7669a99c",
   "key": "l06",
   "text": "He's always on a couch in the alley behind the market."
  },
  "f_22163A911ACD82A2": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_stall__l05.wem",
   "audio_sha256": "eea796b09cb5ca917bfb083bf11cd2020d9057ce3a737216c9fcd474b124396f",
   "key": "l05",
   "text": "Stamps sells new identities. Rey went to him for one. Ask him who else he told."
  },
  "f_22163B911ACD8455": {
   "audio": "source/wkit/raw/mod/return_ticket/audio/vo/gig04_stall__l04.wem",
   "audio_sha256": "a83002bf49aafd3f95bdac747d84c2b01e4a75139713890aa31a9cc7e8c04a7f",
   "key": "l04",
   "text": "Only three people knew he was here. Me, Liban, and a man called Stamps."
  }
 }
}