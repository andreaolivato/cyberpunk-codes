# Fixer 01, the fixer: what the game is told to load, and why each key is here.
#
# THE ONLY HAND-AUTHORED FILE IN THIS MOD. Everything it names is written by a
# generator under tools/fixer01/. Gig 01's manifest carries the full account of
# each key; the comments here record only what is specific to this one.
#
# THIS IS THE FIXER, NOT A GIG: her body, her icon, her contact, her
# introduction call and her conversation. Her gigs are mods of their own
# that require this one.

journal:
  # Her map icon, her contact and its one text, and her codex entry beside
  # the game's own seven fixers.
  - mod\fixer01\journal\fixer01.journal
localization:
  # ENGLISH ONLY, ON PURPOSE. ArchiveXL uses the one language a manifest
  # registers as the fallback for every language it does not, so a player
  # elsewhere reads English, never a raw key, and a translation mod that
  # registers its own language wins (gotcha 121). Registering all nineteen
  # locales here, as this file did until 2026-09-21, would have overwritten
  # any translation. `onscreens` takes a LIST per locale.
  onscreens:
    en-us:
      - mod\fixer01\localization\en-us.json
  # THE SUBTITLES OF HER LINES. Scalar per locale, unlike `onscreens`. She is
  # invented, so every line is ours and needs an entry here.
  subtitles:
    ar-ar: mod\fixer01\localization\subtitles_ar-ar.json
    cz-cz: mod\fixer01\localization\subtitles_cz-cz.json
    de-de: mod\fixer01\localization\subtitles_de-de.json
    en-us: mod\fixer01\localization\subtitles.json
    es-es: mod\fixer01\localization\subtitles_es-es.json
    es-mx: mod\fixer01\localization\subtitles_es-mx.json
    fr-fr: mod\fixer01\localization\subtitles_fr-fr.json
    hu-hu: mod\fixer01\localization\subtitles_hu-hu.json
    it-it: mod\fixer01\localization\subtitles_it-it.json
    jp-jp: mod\fixer01\localization\subtitles_jp-jp.json
    kr-kr: mod\fixer01\localization\subtitles_kr-kr.json
    pl-pl: mod\fixer01\localization\subtitles_pl-pl.json
    pt-br: mod\fixer01\localization\subtitles_pt-br.json
    ru-ru: mod\fixer01\localization\subtitles_ru-ru.json
    th-th: mod\fixer01\localization\subtitles_th-th.json
    tr-tr: mod\fixer01\localization\subtitles_tr-tr.json
    ua-ua: mod\fixer01\localization\subtitles_ua-ua.json
    zh-cn: mod\fixer01\localization\subtitles_zh-cn.json
    zh-tw: mod\fixer01\localization\subtitles_zh-tw.json
  # THE VOICEOVER MAP: her recorded lines, on her calls and in person
  # (tools/fixer01/gen_voice.py).
  vomaps:
    ar-ar: mod\fixer01\localization\vomap.json
    cz-cz: mod\fixer01\localization\vomap.json
    de-de: mod\fixer01\localization\vomap_de-de.json
    en-us: mod\fixer01\localization\vomap.json
    es-es: mod\fixer01\localization\vomap_es-es.json
    es-mx: mod\fixer01\localization\vomap.json
    fr-fr: mod\fixer01\localization\vomap_fr-fr.json
    hu-hu: mod\fixer01\localization\vomap.json
    it-it: mod\fixer01\localization\vomap_it-it.json
    jp-jp: mod\fixer01\localization\vomap_jp-jp.json
    kr-kr: mod\fixer01\localization\vomap_kr-kr.json
    pl-pl: mod\fixer01\localization\vomap_pl-pl.json
    pt-br: mod\fixer01\localization\vomap_pt-br.json
    ru-ru: mod\fixer01\localization\vomap_ru-ru.json
    th-th: mod\fixer01\localization\vomap.json
    tr-tr: mod\fixer01\localization\vomap.json
    ua-ua: mod\fixer01\localization\vomap.json
    zh-cn: mod\fixer01\localization\vomap_zh-cn.json
    zh-tw: mod\fixer01\localization\vomap.json
  # LIPSYNC: which vanilla mouth animation drives each of her lines. Without
  # this key the picks are made and packed and her face does not move (gig
  # 03 shipped that way for a day).
  lipmaps:
    ar-ar: mod\fixer01\localization\fixer01.lipmap
    cz-cz: mod\fixer01\localization\fixer01.lipmap
    de-de: mod\fixer01\localization\fixer01_de-de.lipmap
    en-us: mod\fixer01\localization\fixer01.lipmap
    es-es: mod\fixer01\localization\fixer01_es-es.lipmap
    es-mx: mod\fixer01\localization\fixer01.lipmap
    fr-fr: mod\fixer01\localization\fixer01_fr-fr.lipmap
    hu-hu: mod\fixer01\localization\fixer01.lipmap
    it-it: mod\fixer01\localization\fixer01_it-it.lipmap
    jp-jp: mod\fixer01\localization\fixer01_jp-jp.lipmap
    kr-kr: mod\fixer01\localization\fixer01_kr-kr.lipmap
    pl-pl: mod\fixer01\localization\fixer01_pl-pl.lipmap
    pt-br: mod\fixer01\localization\fixer01_pt-br.lipmap
    ru-ru: mod\fixer01\localization\fixer01_ru-ru.lipmap
    th-th: mod\fixer01\localization\fixer01.lipmap
    tr-tr: mod\fixer01\localization\fixer01.lipmap
    ua-ua: mod\fixer01\localization\fixer01.lipmap
    zh-cn: mod\fixer01\localization\fixer01_zh-cn.lipmap
    zh-tw: mod\fixer01\localization\fixer01.lipmap
streaming:
  blocks:
    # HER BODY, generated by tools/fixer01/gen_community.py: one community
    # entry sitting on the lobby sofa in Charter Hill, and the marker her map
    # icon hangs off, in one always-loaded sector. The registry sector rides
    # along; one block covers both.
    - mod\worlds\03_night_city\_compiled\default\cc_f01_cast.streamingblock
quest:
  phases:
    # THE PARENT IS A SCOPE NAME, NOT A FILE PATH: ArchiveXL expands
    # `cyberpunk2077.quest` to every root quest a session can run, which is
    # what makes the gig exist in a New Game Plus save. gotchas.md 84.
    - path: mod\fixer01\quest\fixer01.questphase
      parent: cyberpunk2077.quest
