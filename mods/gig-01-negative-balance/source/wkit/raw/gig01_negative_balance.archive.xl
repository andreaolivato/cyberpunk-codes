journal:
  - mod\negative_balance\journal\gig01.journal
localization:
  # JOURNAL / UI STRINGS: the gig title, every objective, contact and
  # conversation name, the shard's text, the computer screens.
  #
  # UNDER EVERY LOCALE, which is a FIX (2026-08-14), not decoration. This
  # block used to register `en-us` alone while `subtitles`, `vomaps` and
  # `lipmaps` below were all mapped across the full 19. The result was a
  # specific and quite bad kind of half-broken: a player running the game in
  # any other language got working dialogue, working audio and working lip
  # sync - and RAW LOCKEYS where the gig title, the objectives, Elena's and
  # Nix's contact names and the shard text should be. The gig would have been
  # unplayable in eighteen languages while looking perfect in testing, because
  # testing happens in English.
  #
  # The precedent is exact: zDeceptiousQuestCore ships one en-us onscreens file
  # and maps all 19 locales onto it, which is what a shipped, English-only
  # quest mod does about this.
  #
  # Same reasoning as its three siblings below - the mod is English-only, and
  # English beats a raw LocKey. If it is ever translated, these lines become
  # the place the translations attach.
  onscreens:
    ar-ar:
      - mod\negative_balance\localization\en-us.json
    cz-cz:
      - mod\negative_balance\localization\en-us.json
    de-de:
      - mod\negative_balance\localization\en-us.json
    en-us:
      - mod\negative_balance\localization\en-us.json
    es-es:
      - mod\negative_balance\localization\en-us.json
    es-mx:
      - mod\negative_balance\localization\en-us.json
    fr-fr:
      - mod\negative_balance\localization\en-us.json
    hu-hu:
      - mod\negative_balance\localization\en-us.json
    it-it:
      - mod\negative_balance\localization\en-us.json
    jp-jp:
      - mod\negative_balance\localization\en-us.json
    kr-kr:
      - mod\negative_balance\localization\en-us.json
    pl-pl:
      - mod\negative_balance\localization\en-us.json
    pt-br:
      - mod\negative_balance\localization\en-us.json
    ru-ru:
      - mod\negative_balance\localization\en-us.json
    th-th:
      - mod\negative_balance\localization\en-us.json
    tr-tr:
      - mod\negative_balance\localization\en-us.json
    ua-ua:
      - mod\negative_balance\localization\en-us.json
    zh-cn:
      - mod\negative_balance\localization\en-us.json
    zh-tw:
      - mod\negative_balance\localization\en-us.json
  # Scene dialogue. A scene line resolves its scnlocLocstringId through THIS,
  # not through the scene's own embedded locStore (which the game ignores) and
  # not through onscreens. Without it, choice hubs render blank rows and
  # sections play silently - see docs/scene-playbook.md.
  #
  # Every language points at the same English file on purpose: the mod is
  # English-only, and English beats an empty subtitle.
  subtitles:
    ar-ar: mod\negative_balance\localization\subtitles.json
    cz-cz: mod\negative_balance\localization\subtitles.json
    de-de: mod\negative_balance\localization\subtitles.json
    en-us: mod\negative_balance\localization\subtitles.json
    es-es: mod\negative_balance\localization\subtitles.json
    es-mx: mod\negative_balance\localization\subtitles.json
    fr-fr: mod\negative_balance\localization\subtitles.json
    hu-hu: mod\negative_balance\localization\subtitles.json
    it-it: mod\negative_balance\localization\subtitles.json
    jp-jp: mod\negative_balance\localization\subtitles.json
    kr-kr: mod\negative_balance\localization\subtitles.json
    pl-pl: mod\negative_balance\localization\subtitles.json
    pt-br: mod\negative_balance\localization\subtitles.json
    ru-ru: mod\negative_balance\localization\subtitles.json
    th-th: mod\negative_balance\localization\subtitles.json
    tr-tr: mod\negative_balance\localization\subtitles.json
    ua-ua: mod\negative_balance\localization\subtitles.json
    zh-cn: mod\negative_balance\localization\subtitles.json
    zh-tw: mod\negative_balance\localization\subtitles.json
  # Scene VOICEOVER. Same idea as `subtitles` above and keyed by the SAME RUID:
  # a locVoiceoverMap is a flat, global stringId -> wem list with no scene or
  # quest scoping, so registering ours here is all it takes for the scene system
  # to play our audio natively - no script driver, no Audioware.
  # Generated by tools/gen_voice.py. See docs/backlog.md 2a.
  #
  # English clips under every locale, for the same reason the subtitles are:
  # the mod is English-only, and a voice beats silence.
  vomaps:
    ar-ar: mod\negative_balance\localization\vomap.json
    cz-cz: mod\negative_balance\localization\vomap.json
    de-de: mod\negative_balance\localization\vomap.json
    en-us: mod\negative_balance\localization\vomap.json
    es-es: mod\negative_balance\localization\vomap.json
    es-mx: mod\negative_balance\localization\vomap.json
    fr-fr: mod\negative_balance\localization\vomap.json
    hu-hu: mod\negative_balance\localization\vomap.json
    it-it: mod\negative_balance\localization\vomap.json
    jp-jp: mod\negative_balance\localization\vomap.json
    kr-kr: mod\negative_balance\localization\vomap.json
    pl-pl: mod\negative_balance\localization\vomap.json
    pt-br: mod\negative_balance\localization\vomap.json
    ru-ru: mod\negative_balance\localization\vomap.json
    th-th: mod\negative_balance\localization\vomap.json
    tr-tr: mod\negative_balance\localization\vomap.json
    ua-ua: mod\negative_balance\localization\vomap.json
    zh-cn: mod\negative_balance\localization\vomap.json
    zh-tw: mod\negative_balance\localization\vomap.json
  # LIPSYNC. The fourth and last of ArchiveXL's localization keys, and the one
  # this project had never used. It merges an animLipsyncMapping into the base
  # game's base\localization\<lang>.lipmap: three parallel arrays saying, for
  # scene i and voicetag j, which .anims set drives that actor's mouth.
  #
  # Our entries point at VANILLA lipsync sets - the mod ships no animation data,
  # it borrows an existing animation of about the right length per line. Whole
  # mechanism in tools/gen_lipsync.py; the file itself is written by
  # gen_scenes.write_lipmap().
  #
  # Registered under every locale like its two siblings above, with one caveat
  # worth knowing: the .anims themselves live in lang_en_voice.archive, so a
  # player who installed a different VOICE pack has no such files. The
  # references are Soft, so they resolve to nothing and the mouths simply stay
  # shut. Subtitles and audio are unaffected.
  lipmaps:
    ar-ar: mod\negative_balance\localization\gig01.lipmap
    cz-cz: mod\negative_balance\localization\gig01.lipmap
    de-de: mod\negative_balance\localization\gig01.lipmap
    en-us: mod\negative_balance\localization\gig01.lipmap
    es-es: mod\negative_balance\localization\gig01.lipmap
    es-mx: mod\negative_balance\localization\gig01.lipmap
    fr-fr: mod\negative_balance\localization\gig01.lipmap
    hu-hu: mod\negative_balance\localization\gig01.lipmap
    it-it: mod\negative_balance\localization\gig01.lipmap
    jp-jp: mod\negative_balance\localization\gig01.lipmap
    kr-kr: mod\negative_balance\localization\gig01.lipmap
    pl-pl: mod\negative_balance\localization\gig01.lipmap
    pt-br: mod\negative_balance\localization\gig01.lipmap
    ru-ru: mod\negative_balance\localization\gig01.lipmap
    th-th: mod\negative_balance\localization\gig01.lipmap
    tr-tr: mod\negative_balance\localization\gig01.lipmap
    ua-ua: mod\negative_balance\localization\gig01.lipmap
    zh-cn: mod\negative_balance\localization\gig01.lipmap
    zh-tw: mod\negative_balance\localization\gig01.lipmap
streaming:
  blocks:
    # The data shard on the office desk, generated by tools/gen_sector.py.
    # Its header records everything ruled out before settling on a proximity
    # read.
    #
    # THIS IS THE ONLY SECTOR THE MOD SHIPS. A second block sat here holding
    # two marker nodes for map pins; deleted 2026-08-14, because a node shipped
    # in a MOD sector never registers its global name - proven twice in game
    # ('Can't resolve mappin ... reference'), and confirmed in playtest that
    # Californication and OneMoreLight, which do exactly that, have broken
    # pins too. Pins now anchor to base-game nodes in the game's own
    # always-loaded sectors: see ANCHOR_POS in tools/gen_journal.py and
    # docs/map-pins-playbook.md.
    - mod\worlds\03_night_city\_compiled\default\cc_g01_world.streamingblock
quest:
  phases:
    - path: mod\negative_balance\quest\gig01.questphase
      parent: base\quest\cyberpunk2077.quest
    - path: mod\negative_balance\quest\gig01.questphase
      parent: ep1\quest\ep1_standalone.quest
