journal:
  - mod\negative_balance\journal\gig01.journal
localization:
  # JOURNAL / UI STRINGS: the gig title, every objective, contact and
  # conversation name, the shard's text, the computer screens.
  #
  # ENGLISH ONLY, ON PURPOSE (2026-09-19). ArchiveXL merges the one language a
  # mod registers as the fallback for every language it does not: the entries
  # fill any key nothing else defines and never overwrite one that is. So a
  # player on another language reads English here until a translation exists,
  # never a raw key, and a translation mod that registers its own language
  # wins whichever order the two load in. Measured in game with a second
  # archive overriding one key in Italian; the account is in
  # docs/scene-playbook.md, "Other languages"; each gig's translation-kit/
  # README.md is the page for whoever writes one. The entry of 2026-08-14
  # that said `en-us` alone shows raw keys was reasoned, not measured, and
  # was wrong.
  #
  # A locale gains its own line here when tools/gig01/translations/<locale>.json
  # carries strings: gen_localization.py writes the file and
  # update_manifest_locales.py registers it.
  onscreens:
    en-us:
      - mod\negative_balance\localization\en-us.json
  # Scene dialogue. A scene line resolves its scnlocLocstringId through THIS,
  # not through the scene's own embedded locStore (which the game ignores) and
  # not through onscreens. Without it, choice hubs render blank rows and
  # sections play silently - see docs/scene-playbook.md.
  #
  # One map and one lines file per locale, `_<locale>` suffixed, written by
  # gen_scenes.write_subtitles from the same translation tables. A line the
  # game recorded (vanilla_sid) is not in any of them: the game supplies its
  # own translation and its own dub for those.
  subtitles:
    ar-ar: mod\negative_balance\localization\subtitles_ar-ar.json
    cz-cz: mod\negative_balance\localization\subtitles_cz-cz.json
    de-de: mod\negative_balance\localization\subtitles_de-de.json
    en-us: mod\negative_balance\localization\subtitles.json
    es-es: mod\negative_balance\localization\subtitles_es-es.json
    es-mx: mod\negative_balance\localization\subtitles_es-mx.json
    fr-fr: mod\negative_balance\localization\subtitles_fr-fr.json
    hu-hu: mod\negative_balance\localization\subtitles_hu-hu.json
    it-it: mod\negative_balance\localization\subtitles_it-it.json
    jp-jp: mod\negative_balance\localization\subtitles_jp-jp.json
    kr-kr: mod\negative_balance\localization\subtitles_kr-kr.json
    pl-pl: mod\negative_balance\localization\subtitles_pl-pl.json
    pt-br: mod\negative_balance\localization\subtitles_pt-br.json
    ru-ru: mod\negative_balance\localization\subtitles_ru-ru.json
    th-th: mod\negative_balance\localization\subtitles_th-th.json
    tr-tr: mod\negative_balance\localization\subtitles_tr-tr.json
    ua-ua: mod\negative_balance\localization\subtitles_ua-ua.json
    zh-cn: mod\negative_balance\localization\subtitles_zh-cn.json
    zh-tw: mod\negative_balance\localization\subtitles_zh-tw.json
  # Scene VOICEOVER. Same idea as `subtitles` above and keyed by the SAME RUID:
  # a locVoiceoverMap is a flat, global stringId -> wem list with no scene or
  # quest scoping, so registering ours here is all it takes for the scene system
  # to play our audio natively - no script driver, no Audioware.
  # Generated by tools/gig01/gen_voice.py. See docs/backlog.md 2a.
  #
  # ONE MAP PER DUBBED LANGUAGE (vomap_<locale>.json), written by gen_voice's
  # locale pass: the English map with each vanilla cut swapped for the same
  # cut made in that dub. Elena and Hoshino keep their actors' recordings
  # everywhere. The nine text-only locales use the English map.
  vomaps:
    ar-ar: mod\negative_balance\localization\vomap.json
    cz-cz: mod\negative_balance\localization\vomap.json
    de-de: mod\negative_balance\localization\vomap_de-de.json
    en-us: mod\negative_balance\localization\vomap.json
    es-es: mod\negative_balance\localization\vomap_es-es.json
    es-mx: mod\negative_balance\localization\vomap.json
    fr-fr: mod\negative_balance\localization\vomap_fr-fr.json
    hu-hu: mod\negative_balance\localization\vomap.json
    it-it: mod\negative_balance\localization\vomap_it-it.json
    jp-jp: mod\negative_balance\localization\vomap_jp-jp.json
    kr-kr: mod\negative_balance\localization\vomap_kr-kr.json
    pl-pl: mod\negative_balance\localization\vomap_pl-pl.json
    pt-br: mod\negative_balance\localization\vomap_pt-br.json
    ru-ru: mod\negative_balance\localization\vomap_ru-ru.json
    th-th: mod\negative_balance\localization\vomap.json
    tr-tr: mod\negative_balance\localization\vomap.json
    ua-ua: mod\negative_balance\localization\vomap.json
    zh-cn: mod\negative_balance\localization\vomap_zh-cn.json
    zh-tw: mod\negative_balance\localization\vomap.json
  # LIPSYNC. The fourth and last of ArchiveXL's localization keys, and the one
  # this project had never used. It merges an animLipsyncMapping into the base
  # game's base\localization\<lang>.lipmap: three parallel arrays saying, for
  # scene i and voicetag j, which .anims set drives that actor's mouth.
  #
  # Our entries point at VANILLA lipsync sets - the mod ships no animation data,
  # it borrows an existing animation of about the right length per line. Whole
  # mechanism in tools/gig01/gen_lipsync.py; the file itself is written by
  # gen_scenes.write_lipmap().
  #
  # ONE MAP PER DUBBED LANGUAGE. The .anims live inside each language's own
  # voice archive under that language's folder, same file names, same
  # animation names (measured on the Polish pack), so gig01_<locale>.lipmap is
  # the English map with the folder swapped and the language code set. The
  # nine text-only locales have no voice pack and point at the English map.
  lipmaps:
    ar-ar: mod\negative_balance\localization\gig01.lipmap
    cz-cz: mod\negative_balance\localization\gig01.lipmap
    de-de: mod\negative_balance\localization\gig01_de-de.lipmap
    en-us: mod\negative_balance\localization\gig01.lipmap
    es-es: mod\negative_balance\localization\gig01_es-es.lipmap
    es-mx: mod\negative_balance\localization\gig01.lipmap
    fr-fr: mod\negative_balance\localization\gig01_fr-fr.lipmap
    hu-hu: mod\negative_balance\localization\gig01.lipmap
    it-it: mod\negative_balance\localization\gig01_it-it.lipmap
    jp-jp: mod\negative_balance\localization\gig01_jp-jp.lipmap
    kr-kr: mod\negative_balance\localization\gig01_kr-kr.lipmap
    pl-pl: mod\negative_balance\localization\gig01_pl-pl.lipmap
    pt-br: mod\negative_balance\localization\gig01_pt-br.lipmap
    ru-ru: mod\negative_balance\localization\gig01_ru-ru.lipmap
    th-th: mod\negative_balance\localization\gig01.lipmap
    tr-tr: mod\negative_balance\localization\gig01.lipmap
    ua-ua: mod\negative_balance\localization\gig01.lipmap
    zh-cn: mod\negative_balance\localization\gig01_zh-cn.lipmap
    zh-tw: mod\negative_balance\localization\gig01.lipmap
streaming:
  blocks:
    # The data shard on the office desk, generated by tools/gig01/gen_sector.py.
    # Its header records everything ruled out before settling on a proximity
    # read.
    #
    # THIS IS THE ONLY SECTOR THE MOD SHIPS. A second block sat here holding
    # two marker nodes for map pins, deleted 2026-08-14 because those pins did
    # not resolve: 'Can't resolve mappin ... reference', twice in game, and
    # Californication and OneMoreLight have the same broken pins.
    #
    # THE REASON RECORDED HERE WAS WRONG and is corrected 2026-08-23. It read
    # "a node shipped in a MOD sector never registers its global name". It
    # does. What does not register is the SHORT form, and the short form was
    # all this project had ever written. A node named in full,
    # $/03_night_city/..., resolves and a map pin anchors to it, measured in
    # game (docs/backlog.md 11 and 20, docs/gotchas.md 39).
    #
    # The decision stands on the other reason. A mod sector is streamed by
    # proximity, so an anchor inside one is absent exactly when a pin is wanted
    # from across the city, and an always-loaded sector of our own is a bigger
    # thing to ship than this gig needs. Pins anchor to base-game nodes in the
    # game's own always-loaded sectors: see ANCHOR_POS in
    # tools/gig01/gen_journal.py and docs/map-pins-playbook.md.
    - mod\worlds\03_night_city\_compiled\default\cc_g01_world.streamingblock
    # HOSHINO'S COMMUNITY, generated by tools/gig01/gen_community.py.
    #
    # Two AlwaysLoaded sectors: one holds the community area node and his AI
    # spot, the other holds the worldCommunityRegistryNode. That split is not a
    # preference, it is parts 2 and 3 of the recipe in docs/gotchas.md 66, and
    # sixteen bench runs are behind it.
    #
    # This is what replaced the two-bodies arrangement. He used to be a
    # script-spawned body plus an invisible scene actor a kilometre away
    # carrying the voice and the lipsync; the reported "half-way in a pillar"
    # was that second actor. He is one body now.
    #
    # THE QUEST PHASE IS WHAT KEEPS HIM AWAY until the gig wants him. A
    # community spawns its entries on save load and `entryActiveOnStart: 0` does
    # not stop it, so gig01.questphase deactivates the entry as its first act,
    # activates it when the estate objective goes up, and deactivates it again
    # once he is dead so a reload cannot bring him back alive.
    - mod\worlds\03_night_city\_compiled\default\cc_g01_hoshino.streamingblock
    # THE NORTH OAK ESTATE DETAIL, generated by tools/gig01/gen_estate_guards.py.
    #
    # Thirty guards at thirty posts that were walked and captured in game,
    # replacing a script spawn that scattered twenty-five of them onto navmesh
    # around six anchors. That query is where the huddle came from: nobody had
    # ever said where a guard should stand, so it answered "somewhere near here"
    # and kept giving nearly the same answer.
    #
    # The same two-sector split as Hoshino's above, and for the same reason:
    # parts 2 and 3 of the recipe in docs/gotchas.md 66.
    #
    # ITS OWN COMMUNITY RATHER THAN THIRTY MORE ENTRIES IN HIS. A quest node can
    # then switch the whole detail in one action instead of naming thirty
    # entries, and the security area that gives the trespass warning links to
    # ONE community, which must not be the one holding the man V is there to
    # talk to.
    #
    # gig01.questphase switches it off as its first act, on when the estate
    # objective goes up, and off again after the malware upload. Community state
    # persists in saves, so an entry left active with a dead man in it stands him
    # back up alive on the next load.
    - mod\worlds\03_night_city\_compiled\default\cc_g01_estate.streamingblock
    # THE ARASAKA INDUSTRIAL PARK DETAIL, generated by
    # tools/gig01/gen_compound_guards.py.
    #
    # Thirty guards at thirty walked posts, replacing five anchors and twenty
    # men placed by a navmesh query. Three of those five anchors sat within
    # fifteen metres of each other, so a third of the site's guards were asked
    # for in one corner of one building while the yard, the second gate and
    # every interior floor had nobody. Sixteen of the new posts are off the
    # ground floor, which the old placement could not produce at all.
    #
    # Same two-sector split and the same recipe as the two communities above.
    # gig01.questphase switches it off at the start, on as the office objective
    # goes up, and off once V is clear of the compound.
    - mod\worlds\03_night_city\_compiled\default\cc_g01_compound.streamingblock
  # REMOVING THE VANILLA SHARD FROM THE OFFICE DESK.
  #
  # The desk ships a shard case holding `Items.generic_hanako_flowers_shard`,
  # and the gig puts its own shard beside it, so the desk currently carries
  # two. Exactly one has to be there.
  #
  # ArchiveXL 1.27 can DELETE and MUTATE nodes in a shipped sector but not add
  # to one, which is itself an answer: a mod cannot append its container to the
  # vanilla sector, so its own sector is the only place one can go. The gig's
  # own container is in cc_g01_world.streamingsector above.
  #
  # BOTH NUMBERS COUNT INSTANCES, NOT NODES, which is not what the key name
  # suggests. A sector has a `nodes` table of distinct things and a `nodeData`
  # table of placements of them; this one has 939 and 1242. `expectedNodes`
  # wants 1242, and `index` is into the same table, so the vanilla shard is
  # 591 rather than the 527 it is numbered in `nodes`.
  #
  # The first cut used 939 and 527 and ArchiveXL refused the whole patch:
  #   "The target sector has 1242 node(s), but the mod expects 939."
  # That is a good failure, and its log line is the only reason it cost one
  # launch. tools/gig01/gen_sector.py prints both numbers every run.
  sectors:
    - path: base\worlds\03_night_city\_compiled\default\exterior_-4_-23_0_0.streamingsector
      expectedNodes: 1242
      nodeDeletions:
        - index: 591
          type: worldEntityNode
quest:
  phases:
    # THE PARENT IS A SCOPE NAME, NOT A FILE PATH. That is the whole of New
    # Game Plus compatibility, and it is why this used to be two entries.
    #
    # ArchiveXL ships `Bundle\QuestBaseScope.xl`, which defines the scope
    # `cyberpunk2077.quest` as every root quest a session can run. Out of the
    # box it expands to `base\quest\cyberpunk2077.quest` and
    # `ep1\quest\ep1_standalone.quest`, the two paths this file used to name
    # one by one, so on a vanilla install the two spellings do the same thing.
    #
    # The difference is that another mod can ADD to a scope, and the New Game
    # Plus mod does. A NG+ session does not run the base game's root quest at
    # all: it runs one of three of its own, holding an edited copy of the base
    # root phase, and its .xl registers all three into this same scope. So a
    # phase parented to the literal path is simply not in the graph an NG+
    # session is running, and the gig cannot exist there however healthy the
    # rest of the mod is. That was the 1.3.0 report: the world edits loaded,
    # the trigger script set `cc_g01_start`, and nothing was listening.
    #
    # Named rather than pathed, the gig follows every root, including the
    # three NG+ ones and anything a future mod registers. Quest scopes arrived
    # in ArchiveXL 1.22, which is the floor this line sets.
    - path: mod\negative_balance\quest\gig01.questphase
      parent: cyberpunk2077.quest
