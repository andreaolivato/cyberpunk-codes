      "root": {
        "HandleId": "0",
        "Data": {
          "$type": "localizationPersistenceSubtitleEntries",
          "entries": [
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "V? Sorry. I didn't know if you'd answer. My name's Elena Ortega.",
              "maleVariant": "V? Sorry. I didn't know if you'd answer. My name's Elena Ortega.",
              "stringId": "2468261518880191092"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "I'm from Heywood. Jackie Welles used to help my family.",
              "maleVariant": "I'm from Heywood. Jackie Welles used to help my family.",
              "stringId": "2468264817415075725"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Ortega... yeah. Mama Welles mentioned you.",
              "maleVariant": "Ortega... yeah. Mama Welles mentioned you.",
              "stringId": "3451464606406041500"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "I didn't know who else to call. Jackie said you don't turn your back on people.",
              "maleVariant": "I didn't know who else to call. Jackie said you don't turn your back on people.",
              "stringId": "2468263717903447514"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Start from the top.",
              "maleVariant": "Start from the top.",
              "stringId": "2945234061879031036"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Alright. Start from the top.",
              "maleVariant": "Alright. Start from the top.",
              "stringId": "3451465705917669711"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "I work with community accounts. People's debts are just zeroing out. No disputes. No appeals.",
              "maleVariant": "I work with community accounts. People's debts are just zeroing out. No disputes. No appeals.",
              "stringId": "2468258220345306459"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "When a debtor dies, their account should freeze. Instead, it clears. Immediately. I thought it was a glitch. It's not. Too many times.",
              "maleVariant": "When a debtor dies, their account should freeze. Instead, it clears. Immediately. I thought it was a glitch. It's not. Too many times.",
              "stringId": "2468257120833678248"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "I wasn't authorized to see this. I only noticed because I handle reconciliations. My access was revoked afterward.",
              "maleVariant": "I wasn't authorized to see this. I only noticed because I handle reconciliations. My access was revoked afterward.",
              "stringId": "2468260419368562881"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Hold on. Are you safe right now?",
              "maleVariant": "Hold on. Are you safe right now?",
              "stringId": "3451462407382785078"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "I... don't know.",
              "maleVariant": "I... don't know.",
              "stringId": "2468259319856934670"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Go to Mama Welles.",
              "maleVariant": "Go to Mama Welles.",
              "stringId": "2945231862855774614"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Okay. Listen to me. Go to El Coyote. Stay with Mama Welles. I'll check what I can. Where do you work?",
              "maleVariant": "Okay. Listen to me. Go to El Coyote. Stay with Mama Welles. I'll check what I can. Where do you work?",
              "stringId": "3451463506894413289"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Sending you the location.",
              "maleVariant": "Sending you the location.",
              "stringId": "2468253822298793615"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Got it. Wait. That's-",
              "maleVariant": "Got it. Wait. That's-",
              "stringId": "3286018873504984006"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Fucking Arasaka...",
              "maleVariant": "Fucking Arasaka...",
              "stringId": "3134096055015834638"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "That's not debt collection.",
              "maleVariant": "That's not debt collection.",
              "stringId": "2451540347895706053"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "It's a production line.",
              "maleVariant": "It's a production line.",
              "stringId": "2451537049360821420"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Insure them. Flatline them. Get the eddies.",
              "maleVariant": "Insure them. Flatline them. Get the eddies.",
              "stringId": "2451538148872449631"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Welcome to corporate efficiency.",
              "maleVariant": "Welcome to corporate efficiency.",
              "stringId": "2451534850337564998"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Yeah. With a body count.",
              "maleVariant": "Yeah. With a body count.",
              "stringId": "2451535949849193209"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "We need a netrunner to find who's responsible.",
              "maleVariant": "We need a netrunner to find who's responsible.",
              "stringId": "2452531007872534939"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "We know one.",
              "maleVariant": "We know one.",
              "stringId": "2451549143988731741"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "A data shard... might contain more info",
              "maleVariant": "A data shard... might contain more info",
              "stringId": "3278609694267274204"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "They're not sending their own. They're paying mercs.",
              "maleVariant": "They're not sending their own. They're paying mercs.",
              "stringId": "2601118040768300233"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "We do the killing.",
              "maleVariant": "We do the killing.",
              "stringId": "2601116941256672022"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Figures.",
              "maleVariant": "Figures.",
              "stringId": "3190548634285517787"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Bad. Arasaka's running a kill ledger.",
              "maleVariant": "Bad. Arasaka's running a kill ledger.",
              "stringId": "2471150095423650099"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Cracked the logs. Downloaded the ledger.",
              "maleVariant": "Cracked the logs. Downloaded the ledger.",
              "stringId": "2471151194935278310"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Someone's signing off on every one of these.",
              "maleVariant": "Someone's signing off on every one of these.",
              "stringId": "2471154493470162943"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Find me the name.",
              "maleVariant": "Find me the name.",
              "stringId": "2471155592981791154"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "That's exec-tier heat, V.",
              "maleVariant": "That's exec-tier heat, V.",
              "stringId": "3152720861816928544"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "I can dig, but who's paying?",
              "maleVariant": "I can dig, but who's paying?",
              "stringId": "3152721961328556755"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "I am.",
              "maleVariant": "I am.",
              "stringId": "2471153393958534732"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Heh. That'll take a minute.",
              "maleVariant": "Heh. That'll take a minute.",
              "stringId": "3152727458886697810"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "I'll call you back.",
              "maleVariant": "I'll call you back.",
              "stringId": "3152728558398326021"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Is this how a merc becomes a legend in Night City?",
              "maleVariant": "Is this how a merc becomes a legend in Night City?",
              "stringId": "3050084377981093128"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Killing to pad Arasaka's books?",
              "maleVariant": "Killing to pad Arasaka's books?",
              "stringId": "3050092074562490605"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No.",
              "maleVariant": "No.",
              "stringId": "3050090975050862394"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "A legend picks who pays",
              "maleVariant": "A legend picks who pays",
              "stringId": "3050085477492721339"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "V. You were right.",
              "maleVariant": "V. You were right.",
              "stringId": "2573356912386719559"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Arasaka pays mercs to flatline debtors after insuring them.",
              "maleVariant": "Arasaka pays mercs to flatline debtors after insuring them.",
              "stringId": "2573352514340206715"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "One exec signs off on all of it. Hoshino.",
              "maleVariant": "One exec signs off on all of it. Hoshino.",
              "stringId": "2573353613851834926"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nothing pays without his sign-off. Ever.",
              "maleVariant": "Nothing pays without his sign-off. Ever.",
              "stringId": "2573359111409975981"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Where.",
              "maleVariant": "Where.",
              "stringId": "3153517521391216942"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "North Oak. Private Arasaka residence.",
              "maleVariant": "North Oak. Private Arasaka residence.",
              "stringId": "2573351414828578504"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Of course it is.",
              "maleVariant": "Of course it is.",
              "stringId": "2519848024849527000"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Arasaka owns the hill and the graves.",
              "maleVariant": "Arasaka owns the hill and the graves.",
              "stringId": "2519851323384411633"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Mmm? You lost, merc?",
              "maleVariant": "Mmm? You lost, merc?",
              "stringId": "2306897379080263501"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Do you know who I am?",
              "maleVariant": "Do you know who I am?",
              "stringId": "2306894080545378868"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Name what he signed.",
              "maleVariant": "Name what he signed.",
              "stringId": "2560549213621789016"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "I know what you signed. I know who paid for it.",
              "maleVariant": "I know what you signed. I know who paid for it.",
              "stringId": "2394653800302689115"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Ledger's closed.",
              "maleVariant": "Ledger's closed.",
              "stringId": "2587598248123592664"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "They always think names beat bullets.",
              "maleVariant": "They always think names beat bullets.",
              "stringId": "2587601546658477297"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No more payouts.",
              "maleVariant": "No more payouts.",
              "stringId": "2459146267589536473"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No money, no bodies.",
              "maleVariant": "No money, no bodies.",
              "stringId": "2459142969054651840"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "You look tired, mija.",
              "maleVariant": "You look tired, mijo.",
              "stringId": "3094859395754454110"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Long night. She okay?",
              "maleVariant": "Long night. She okay?",
              "stringId": "2864505112474282009"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Long night. She okay?",
              "maleVariant": "Long night. She okay?",
              "stringId": "3197233823009623074"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "She's in the back.",
              "maleVariant": "She's in the back.",
              "stringId": "3094858296242825899"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nova. I'll get a drink.",
              "maleVariant": "Nova. I'll get a drink.",
              "stringId": "2864501813939397376"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nova. I'll get a drink.",
              "maleVariant": "Nova. I'll get a drink.",
              "stringId": "3197232723497994863"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "You look tired, mija.",
              "maleVariant": "You look tired, mijo.",
              "stringId": "2772686332101839606"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Long night. She okay?",
              "maleVariant": "Long night. She okay?",
              "stringId": "2603588040640448337"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Long night. She okay?",
              "maleVariant": "Long night. She okay?",
              "stringId": "3080977295653532810"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "She's in the back.",
              "maleVariant": "She's in the back.",
              "stringId": "2772685232590211395"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nova. I'll get a drink.",
              "maleVariant": "Nova. I'll get a drink.",
              "stringId": "2603584742105563704"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nova. I'll get a drink.",
              "maleVariant": "Nova. I'll get a drink.",
              "stringId": "3080976196141904599"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "She'll never know how many people died for a clean ledger.",
              "maleVariant": "She'll never know how many people died for a clean ledger.",
              "stringId": "3235239635471382945"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Good. Let her sleep.",
              "maleVariant": "Good. Let her sleep.",
              "stringId": "2952587081459960444"
            }
          ]
        }
      }
    },
    "EmbeddedFiles": []
  }
}