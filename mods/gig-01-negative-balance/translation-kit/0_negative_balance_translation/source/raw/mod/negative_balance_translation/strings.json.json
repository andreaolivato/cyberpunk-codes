              "secondaryKey": "cc-g01-obj-estate"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Find a way into the residence",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-obj-wayin"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Find Hoshino",
              "maleVariant": "",
