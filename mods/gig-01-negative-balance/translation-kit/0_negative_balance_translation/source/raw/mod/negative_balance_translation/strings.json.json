            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Elena Ortega",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-elena-ortega-name"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Elena",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-elena-short"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "V? It's Elena Ortega. I need your help.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-conv-title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Nix",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-nix-name"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "That ledger you sent me.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-nix-conv-title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Get off your vehicle to talk to Nix.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-vehicle-dismount"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Negative Balance",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-gig-title"
            },
            {
