            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Trauma Team International, Night City.\n\nProbation crews wanted. Combat experience required. Paid per call, rank up after five shifts.\n\nInterviews in person at the Medical Center, Little China. Ask for intake at the staff entrance.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g05-msg-ad"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Shift logged. Three calls, fees paid.\n\nProbation crews are called in as shifts open. The next one will be posted here.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g05-msg-done"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Shifts available. Same crew, your pick of shift. Ask at intake outside the Medical Center, 12 hours after your last shift.\n\nNew shifts will be posted here.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g05-msg-repeat"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "New shift posted. Your crew is waiting on the roof. Staff elevator, then the armory.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g05-msg-s2"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Second shift logged. Fees paid, less a refund for every client lost.\n\nFrom now on intake can put you on either shift.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g05-msg-s2-done"
