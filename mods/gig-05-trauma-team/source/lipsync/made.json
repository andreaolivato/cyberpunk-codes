{
 "gig05_interview/recruiter": {
  "f_2EBDA2297C14B350": {
   "audio": "source/wkit/raw/mod/trauma_team/audio/vo/gig05_interview__r07.wem",
   "audio_sha256": "54adf2735119771a04a97334ebeaeaac36524a5ad882b48c4642ec0ae100c9cf",
   "key": "r07",
   "text": "Staff elevator's out in the tank yard, up to the roof."
  },
  "f_2EBDA3297C14B503": {
   "audio": "source/wkit/raw/mod/trauma_team/audio/vo/gig05_interview__r06.wem",
   "audio_sha256": "752b2ea93fa0046fbe3897b4028f1e1c100801de664af0d60941110f249ed3fb",
   "key": "r06",
   "text": "Remember, we have one rule. The client lives. Everything else comes second."
  },
  "f_2EBDA4297C14B6B6": {
   "audio": "source/wkit/raw/mod/trauma_team/audio/vo/gig05_interview__r05.wem",
   "audio_sha256": "2599711646953bd1b0ac39124c53198d9b40a50d4251e2c2229a117aac97d1d2",
   "key": "r05",
   "text": "Now. On probation, of course."
  },
  "f_2EBDA5297C14B869": {
   "audio": "source/wkit/raw/mod/trauma_team/audio/vo/gig05_interview__r04.wem",
   "audio_sha256": "dbe0082ffed8ffcfb35f94e5bd6d779852c1414b6c03218ddd2cf1e8df1288b8",
   "key": "r04",
   "text": "Good. Brekke's the crew leader. He'll evaluate you at the end of shift."
  },
  "f_2EBDA6297C14BA1C": {
   "audio": "source/wkit/raw/mod/trauma_team/audio/vo/gig05_interview__r03.wem",
   "audio_sha256": "a5ee3bba78a26ee2a0647c1451e4cbe383e2b7d6107327130cf192898499686f",
   "key": "r03",
   "text": "Do you have combat experience?"
  },
  "f_2EBDA7297C14BBCF": {
   "audio": "source/wkit/raw/mod/trauma_team/audio/vo/gig05_interview__r02.wem",
   "audio_sha256": "9dd973f69488163d310e27f055d5ff1c0800aba7b1678ca53309e0002af245ed",
   "key": "r02",
   "text": "Each shift is up to three calls, paid per call."
  },
  "f_2EBDA8297C14BD82": {
   "audio": "source/wkit/raw/mod/trauma_team/audio/vo/gig05_interview__r01.wem",
   "audio_sha256": "c4708afef334f3f93e3bcc92256618e6c5b3fd7386ca983326b99b97e738b61d",
   "key": "r01",
   "text": "Hmm, a new recruit. Hope you're better than the last batch."
  },
  "f_2EBDB0297C14CB1A": {
   "audio": "source/wkit/raw/mod/trauma_team/audio/vo/gig05_interview__r09.wem",
   "audio_sha256": "c4581819cd314306fcc70221941345e6a9541a208403dfa502d54e542a0a849d",
   "key": "r09",
   "text": "We need a gun. Protect the client, protect the medic, clear the scene."
  },
  "f_2EBDB1297C14CCCD": {
   "audio": "source/wkit/raw/mod/trauma_team/audio/vo/gig05_interview__r08.wem",
   "audio_sha256": "21a15671eb93900fdaa932607e9c6efc97c2c9af27215caa1d5be1e0f53af102",
   "key": "r08",
   "text": "Get changed in the armory, then meet the team on the landing pad. They'll be waiting."
  }
 }
}