# Trauma Team: what the game is told to load, and why each key is here.
#
# THE ONLY HAND-AUTHORED FILE IN THIS MOD. Everything it names is written by a
# generator under tools/gig05/. Gig 01's manifest carries the full account of
# each key; the comments here record only what is specific to this gig.
#
# NO OTHER MOD OF OURS IS NEEDED: Trauma Team hires V directly, so there is
# no fixer to require.

factories:
  - mod\trauma_team\outfit\outfit.csv
journal:
  - mod\trauma_team\journal\gig05.journal
localization:
  # ENGLISH ONLY, ON PURPOSE: ArchiveXL merges it as the fallback for every
  # other language (gotcha 121). `onscreens` takes a LIST per locale.
  onscreens:
    en-us:
      - mod\trauma_team\localization\en-us.json
  # THE SUBTITLES OF THE SCENE LINES. Scalar per locale. English only until
  # the lines are final; tools/update_manifest_locales.py writes the rest.
  subtitles:
    ar-ar: mod\trauma_team\localization\subtitles_ar-ar.json
    cz-cz: mod\trauma_team\localization\subtitles_cz-cz.json
    de-de: mod\trauma_team\localization\subtitles_de-de.json
    en-us: mod\trauma_team\localization\subtitles.json
    es-es: mod\trauma_team\localization\subtitles_es-es.json
    es-mx: mod\trauma_team\localization\subtitles_es-mx.json
    fr-fr: mod\trauma_team\localization\subtitles_fr-fr.json
    hu-hu: mod\trauma_team\localization\subtitles_hu-hu.json
    it-it: mod\trauma_team\localization\subtitles_it-it.json
    jp-jp: mod\trauma_team\localization\subtitles_jp-jp.json
    kr-kr: mod\trauma_team\localization\subtitles_kr-kr.json
    pl-pl: mod\trauma_team\localization\subtitles_pl-pl.json
    pt-br: mod\trauma_team\localization\subtitles_pt-br.json
    ru-ru: mod\trauma_team\localization\subtitles_ru-ru.json
    th-th: mod\trauma_team\localization\subtitles_th-th.json
    tr-tr: mod\trauma_team\localization\subtitles_tr-tr.json
    ua-ua: mod\trauma_team\localization\subtitles_ua-ua.json
    zh-cn: mod\trauma_team\localization\subtitles_zh-cn.json
    zh-tw: mod\trauma_team\localization\subtitles_zh-tw.json
  # THE RECORDED LINES, Nisha's and Brekke's. V, Wrona and Raman speak the
  # game's own recordings, which need no map. Scalar per locale.
  vomaps:
    ar-ar: mod\trauma_team\localization\vomap.json
    cz-cz: mod\trauma_team\localization\vomap.json
    de-de: mod\trauma_team\localization\vomap_de-de.json
    en-us: mod\trauma_team\localization\vomap.json
    es-es: mod\trauma_team\localization\vomap_es-es.json
    es-mx: mod\trauma_team\localization\vomap.json
    fr-fr: mod\trauma_team\localization\vomap_fr-fr.json
    hu-hu: mod\trauma_team\localization\vomap.json
    it-it: mod\trauma_team\localization\vomap_it-it.json
    jp-jp: mod\trauma_team\localization\vomap_jp-jp.json
    kr-kr: mod\trauma_team\localization\vomap_kr-kr.json
    pl-pl: mod\trauma_team\localization\vomap_pl-pl.json
    pt-br: mod\trauma_team\localization\vomap_pt-br.json
    ru-ru: mod\trauma_team\localization\vomap_ru-ru.json
    th-th: mod\trauma_team\localization\vomap.json
    tr-tr: mod\trauma_team\localization\vomap.json
    ua-ua: mod\trauma_team\localization\vomap.json
    zh-cn: mod\trauma_team\localization\vomap_zh-cn.json
    zh-tw: mod\trauma_team\localization\vomap.json
  lipmaps:
    ar-ar: mod\trauma_team\localization\gig05.lipmap
    cz-cz: mod\trauma_team\localization\gig05.lipmap
    de-de: mod\trauma_team\localization\gig05_de-de.lipmap
    en-us: mod\trauma_team\localization\gig05.lipmap
    es-es: mod\trauma_team\localization\gig05_es-es.lipmap
    es-mx: mod\trauma_team\localization\gig05.lipmap
    fr-fr: mod\trauma_team\localization\gig05_fr-fr.lipmap
    hu-hu: mod\trauma_team\localization\gig05.lipmap
    it-it: mod\trauma_team\localization\gig05_it-it.lipmap
    jp-jp: mod\trauma_team\localization\gig05_jp-jp.lipmap
    kr-kr: mod\trauma_team\localization\gig05_kr-kr.lipmap
    pl-pl: mod\trauma_team\localization\gig05_pl-pl.lipmap
    pt-br: mod\trauma_team\localization\gig05_pt-br.lipmap
    ru-ru: mod\trauma_team\localization\gig05_ru-ru.lipmap
    th-th: mod\trauma_team\localization\gig05.lipmap
    tr-tr: mod\trauma_team\localization\gig05.lipmap
    ua-ua: mod\trauma_team\localization\gig05.lipmap
    zh-cn: mod\trauma_team\localization\gig05_zh-cn.lipmap
    zh-tw: mod\trauma_team\localization\gig05.lipmap
# THE UNIFORM V KEEPS: the clothing mods' factory (tools/gig05/gen_recruiter.py).
resource:
  patch:
    mod\trauma_team\lift\lift.devices:
      - base\worlds\03_night_city\_compiled\default\03_night_city.devices
      - base\worlds\03_night_city\_compiled\default\03_night_city_init.devices
    mod\trauma_team\lift\lift.psrep:
      - base\worlds\03_night_city\_compiled\default\03_night_city.psrep
streaming:
  blocks:
    # THE CAST, generated by tools/gig05/gen_community.py: the recruiter,
    # the AV on its pad, the crew, the roof's client and Scavs, the
    # prompts' markers and the two flight paths. The registry sector rides
    # along with the community sector; one block covers both.
    - mod\worlds\03_night_city\_compiled\default\cc_g05_cast.streamingblock
quest:
  phases:
    # THE PARENT IS A SCOPE NAME, NOT A FILE PATH (gotcha 84).
    - path: mod\trauma_team\quest\gig05.questphase
      parent: cyberpunk2077.quest
