{
 "gig02_beaten/merc": {
  "f_26B6AA831C771E08": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_beaten__m32.wem",
   "audio_sha256": "9960f87ac7263833ffdd2a540181ed3826320df4984e4098c29b684050c72dcb",
   "key": "m32",
   "text": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it."
  },
  "f_26B6AB831C771FBB": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_beaten__m33.wem",
   "audio_sha256": "be31a155c706d95bdec2b452901bd960985af88ab02c9b81da8e70cd5d80fb6c",
   "key": "m33",
   "text": "Look for yourself."
  },
  "f_26B6AC831C77216E": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_beaten__m30.wem",
   "audio_sha256": "99e2e8dc9c295d6714da5e7aa210185961f96de33d7ef8d73caf147ee0cb6d4c",
   "key": "m30",
   "text": "No! Wait! Why?"
  },
  "f_26B6AD831C772321": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_beaten__m31.wem",
   "audio_sha256": "11f11441471b92da07fb9f450c5e4a16dedd5e924ea087f9600e08b416312aee",
   "key": "m31",
   "text": "Wakako? She hired me!"
  },
  "f_26BA29831C7A2BAC": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_beaten__m29.wem",
   "audio_sha256": "5e7bf2193cf8f027bdf34927c83a295e77de4ed22ed39f0406b600f560480f57",
   "key": "m29",
   "text": "Ugh!"
  }
 },
 "gig02_char_call/char": {
  "f_2BCB546F5A7D863C": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_char_call__c10.wem",
   "audio_sha256": "96c944c4e36f5c3dc77f7ad16a780fb533acf3a0706fc6b5938cdd603514b9ce",
   "key": "c10",
   "text": "Jack in, breach it, and send me everything it's been carrying."
  },
  "f_2BCEE16F5A80ABAA": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_char_call__c09.wem",
   "audio_sha256": "77ec12a6e706dbd5aea747c6f4ee1f2c253f6b2af3553f1f037bb465d2d9793a",
   "key": "c09",
   "text": "Good, you're in. There's a hardline access point on the wall at the back. Whatever sent those orders went through it."
  }
 },
 "gig02_close_clean/wakako": {
  "f_2F843A3A981144DC": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_close_clean__w42.wem",
   "audio_sha256": "c03702740e22315af10afc16820053aef136444f9b268279e80901451557da71",
   "key": "w42",
   "text": "You entered and left like a ghost, V."
  }
 },
 "gig02_close_loud/wakako": {
  "f_2F4E46DA2E5165C8": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_close_loud__w43.wem",
   "audio_sha256": "6830a2ad09a9be0d3297583f7335d43271c2548f21254a7fad6dad15c1ac6af0",
   "key": "w43",
   "text": "You were to do this quietly. It was anything but."
  }
 },
 "gig02_group3/merc": {
  "f_23FD26BD540E10E8": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_group3__q08b.wem",
   "audio_sha256": "1d6f26946ae8c9d05da6bec1d4716121dec9dc8fe5a247ab9bfb29caeb09fdf7",
   "key": "q08b",
   "text": "Pow!"
  },
  "f_269263CE69891103": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_group3__q07.wem",
   "audio_sha256": "160044b710472e3bb69fa8a5bea2a516acf3ce9fe4bc4d2c4bcc3f388ab28656",
   "key": "q07",
   "text": "Heh. They didn't even make it out of the car."
  },
  "f_269270CE6989271A": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_group3__q08.wem",
   "audio_sha256": "6447b5a9aa53bd8570450dbdfb0c0386aa42314b6e354890faf3b366c72b10f2",
   "key": "q08",
   "text": "Shotgun through the glass."
  },
  "f_269271CE698928CD": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_group3__q09.wem",
   "audio_sha256": "dd98d4791442def73f7a478eb6e686a8dcf5237e58eb56a9ddd4996b0342aec9",
   "key": "q09",
   "text": "Over before anyone on Jig-Jig Street could even scream."
  }
 },
 "gig02_handover/char": {
  "f_27002C96A826BA24": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_handover__c01.wem",
   "audio_sha256": "aa31f82d31d02a9f1454fcc4b05d1f8dd378bfc53bdc85ca1b691335de3ed77f",
   "key": "c01",
   "text": "Nova."
  },
  "f_27002F96A826BF3D": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_handover__c02.wem",
   "audio_sha256": "3a96b0d58937942b50503f26bb8814faf64f04cce622bdd809ee3d4e6fe71cee",
   "key": "c02",
   "text": "Give me half an hour. I'll message you."
  }
 },
 "gig02_office/wakako": {
  "f_2770AD524483B8E1": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_office__w47.wem",
   "audio_sha256": "b6d5954c996663e72f7d1bab875328f09fc74ea57874476e7f144c88184a9740",
   "key": "w47",
   "text": "So tell me."
  },
  "f_2770AF524483BC47": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_office__w41.wem",
   "audio_sha256": "e9f856cd6cb4fa2998b61eaa7d07a28fe24b748a5726e48e959089a6fc0acda4",
   "key": "w41",
   "text": "Something must have happened. He would not dare go against me."
  },
  "f_277434524486D41D": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_office__w50.wem",
   "audio_sha256": "8897548000c982d86df61eb07112b4b6100a3d1ee6e40c6635d2c47dd8417b4d",
   "key": "w50",
   "text": "Discreet and with finesse."
  }
 },
 "gig02_wakako_call/wakako": {
  "f_21D15B75C399CD1C": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_wakako_call__w45.wem",
   "audio_sha256": "4c6f104158ff329e6f854d705c16044a25df000f2f917d421592468a535db455",
   "key": "w45",
   "text": "I need someone for a quick and quiet operation."
  },
  "f_21D15C75C399CECF": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_wakako_call__w44.wem",
   "audio_sha256": "28ca34d1f4025e3171f2ba7bc9d9cda321aa70400fda8b5b64750d88c0758213",
   "key": "w44",
   "text": "Only me, no client \u2013 so I expect quick and clean results."
  },
  "f_21D15E75C399D235": {
   "audio": "source/wkit/raw/mod/dead_ringer/audio/vo/gig02_wakako_call__w46.wem",
   "audio_sha256": "425c94e37e2ca76621edfaaad14bbce556b7e6ed55e3e952d8bd94bd4e377b68",
   "key": "w46",
   "text": "You're the only one I trust with it."
  }
 }
}