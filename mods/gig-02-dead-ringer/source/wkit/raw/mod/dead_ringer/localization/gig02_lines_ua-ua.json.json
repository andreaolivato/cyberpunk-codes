        "Data": {
          "$type": "localizationPersistenceSubtitleEntries",
          "entries": [
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u041c\u0435\u043d\u0456 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u043b\u044e\u0434\u0438\u043d\u0430 \u0434\u043b\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0457 \u0442\u0430 \u0442\u0438\u0445\u043e\u0457 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0457.",
              "maleVariant": "\u041c\u0435\u043d\u0456 \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u043b\u044e\u0434\u0438\u043d\u0430 \u0434\u043b\u044f \u0448\u0432\u0438\u0434\u043a\u043e\u0457 \u0442\u0430 \u0442\u0438\u0445\u043e\u0457 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0457.",
              "stringId": "2436829434735086876"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u0421\u0430\u043c\u0435 \u043c\u0435\u043d\u0456, \u0430 \u043d\u0435 \u043a\u043b\u0456\u0454\u043d\u0442\u0443, \u0442\u043e\u043c\u0443 \u043e\u0447\u0456\u043a\u0443\u044e \u0448\u0432\u0438\u0434\u043a\u043e\u0433\u043e \u0442\u0430 \u0430\u043a\u0443\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443.",
              "maleVariant": "\u0421\u0430\u043c\u0435 \u043c\u0435\u043d\u0456, \u0430 \u043d\u0435 \u043a\u043b\u0456\u0454\u043d\u0442\u0443, \u0442\u043e\u043c\u0443 \u043e\u0447\u0456\u043a\u0443\u044e \u0448\u0432\u0438\u0434\u043a\u043e\u0433\u043e \u0442\u0430 \u0430\u043a\u0443\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443.",
              "stringId": "2436830534246715087"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Listen.",
              "maleVariant": "Listen.",
              "stringId": "3120035173233574268"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u0422\u0456\u043b\u044c\u043a\u0438 \u0442\u043e\u0431\u0456 \u0439\u043e\u0433\u043e \u043c\u043e\u0436\u0443 \u0434\u043e\u0432\u0456\u0440\u0438\u0442\u0438.",
              "maleVariant": "\u0422\u0456\u043b\u044c\u043a\u0438 \u0442\u043e\u0431\u0456 \u0439\u043e\u0433\u043e \u043c\u043e\u0436\u0443 \u0434\u043e\u0432\u0456\u0440\u0438\u0442\u0438.",
              "stringId": "2436832733269971509"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Heh. They didn't even make it out of the car.",
              "maleVariant": "Heh. They didn't even make it out of the car.",
              "stringId": "2779393658226020611"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Shotgun through the glass.",
              "maleVariant": "Shotgun through the glass.",
              "stringId": "2779407951877187354"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Pow!",
              "maleVariant": "Pow!",
              "stringId": "2593271555036156136"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "maleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "stringId": "2779409051388815565"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Ugh!",
              "maleVariant": "Ugh!",
              "stringId": "2790588562204666796"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! Wait! Why?",
              "maleVariant": "No! Wait! Why?",
              "stringId": "2789606698320863598"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Wakako? She hired me!",
              "maleVariant": "Wakako? She hired me!",
              "stringId": "2789607797832491809"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "maleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "stringId": "2789604499297607176"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Look for yourself.",
              "maleVariant": "Look for yourself.",
              "stringId": "2789605598809235387"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Finish it.",
              "maleVariant": "Finish it.",
              "stringId": "2420173659152984664"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Let him go.",
              "maleVariant": "Let him go.",
              "stringId": "2420174758664612875"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Connect.",
              "maleVariant": "Connect.",
              "stringId": "3315287305784286272"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Hand it over.",
              "maleVariant": "Hand it over.",
              "stringId": "3093055499208003535"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nova.",
              "maleVariant": "Nova.",
              "stringId": "2810295193057016356"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Give me half an hour. I'll message you.",
              "maleVariant": "Give me half an hour. I'll message you.",
              "stringId": "2810298491591900989"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Good, you're in. There's a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "maleVariant": "Good, you're in. There's a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "stringId": "3156708257209297834"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Jack in, breach it, and send me everything it's been carrying.",
              "maleVariant": "Jack in, breach it, and send me everything it's been carrying.",
              "stringId": "3155708801139443260"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Share what you found with Wakako.",
              "maleVariant": "Share what you found with Wakako.",
              "stringId": "2396304581542984411"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u0422\u043e\u0434\u0456 \u0440\u043e\u0437\u043f\u043e\u0432\u0456\u0434\u0430\u0439.",
              "maleVariant": "\u0422\u043e\u0434\u0456 \u0440\u043e\u0437\u043f\u043e\u0432\u0456\u0434\u0430\u0439.",
              "stringId": "2841961933719189729"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Show her Char's trace.",
              "maleVariant": "Show her Char's trace.",
              "stringId": "2395321618147553002"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u041c\u0430\u0431\u0443\u0442\u044c, \u0449\u043e\u0441\u044c \u0441\u0442\u0430\u043b\u043e\u0441\u044f. \u0412\u0456\u043d \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043f\u0456\u0448\u043e\u0432 \u0431\u0438 \u043f\u0440\u043e\u0442\u0438 \u043c\u0435\u043d\u0435.",
              "maleVariant": "\u041c\u0430\u0431\u0443\u0442\u044c, \u0449\u043e\u0441\u044c \u0441\u0442\u0430\u043b\u043e\u0441\u044f. \u0412\u0456\u043d \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043f\u0456\u0448\u043e\u0432 \u0431\u0438 \u043f\u0440\u043e\u0442\u0438 \u043c\u0435\u043d\u0435.",
              "stringId": "2841964132742446151"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u041d\u0435\u043f\u043e\u043c\u0456\u0442\u043d\u043e \u0442\u0430 \u0432\u0438\u0442\u043e\u043d\u0447\u0435\u043d\u043e, \u0447\u043e\u0433\u043e \u043d\u0435 \u0441\u043a\u0430\u0436\u0435\u0448 \u043f\u0440\u043e \u0440\u043e\u0437\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u043f\u0430\u043d\u0430 \u0413\u0443\u0442\u044c\u0454\u0440\u0440\u0435\u0441\u0430.",
              "maleVariant": "\u041d\u0435\u043f\u043e\u043c\u0456\u0442\u043d\u043e \u0442\u0430 \u0432\u0438\u0442\u043e\u043d\u0447\u0435\u043d\u043e, \u0447\u043e\u0433\u043e \u043d\u0435 \u0441\u043a\u0430\u0436\u0435\u0448 \u043f\u0440\u043e \u0440\u043e\u0437\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u043f\u0430\u043d\u0430 \u0413\u0443\u0442\u044c\u0454\u0440\u0440\u0435\u0441\u0430.",
              "stringId": "2842954792719275037"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u0422\u0438 \u043d\u0430\u0447\u0435 \u043f\u0440\u0438\u0432\u0438\u0434, \u0412\u0456.",
              "maleVariant": "\u0422\u0438 \u043d\u0430\u0447\u0435 \u043f\u0440\u0438\u0432\u0438\u0434, \u0412\u0456.",
              "stringId": "3423925640042202332"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u0422\u0440\u0435\u0431\u0430 \u0431\u0443\u043b\u043e \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0432\u0441\u0435 \u0442\u0438\u0445\u043e. \u0410\u043b\u0435 \u0431\u0443\u043b\u043e \u0437\u043e\u0432\u0441\u0456\u043c \u043d\u0435 \u0442\u0430\u043a.",
              "maleVariant": "\u0422\u0440\u0435\u0431\u0430 \u0431\u0443\u043b\u043e \u0437\u0440\u043e\u0431\u0438\u0442\u0438 \u0432\u0441\u0435 \u0442\u0438\u0445\u043e. \u0410\u043b\u0435 \u0431\u0443\u043b\u043e \u0437\u043e\u0432\u0441\u0456\u043c \u043d\u0435 \u0442\u0430\u043a.",
              "stringId": "3408739870859945416"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Lean on the railing and wait for Char.",
              "maleVariant": "Lean on the railing and wait for Char.",
              "stringId": "3327307582760467917"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Sit down and wait for Char.",
              "maleVariant": "Sit down and wait for Char.",
              "stringId": "2623302448557323786"
            }
          ]
        }
      }
