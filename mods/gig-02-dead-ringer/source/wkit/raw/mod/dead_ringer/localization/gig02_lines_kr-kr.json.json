          "entries": [
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\ube60\ub974\uace0 \uc870\uc6a9\ud558\uac8c \uc77c\ud574\uc904 \uc0ac\ub78c\uc774 \ud544\uc694\ud574.",
              "maleVariant": "\ube60\ub974\uace0 \uc870\uc6a9\ud558\uac8c \uc77c\ud574\uc904 \uc0ac\ub78c\uc774 \ud544\uc694\ud574.",
              "stringId": "2436829434735086876"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\ub0b4\uac00 \uc758\ub8b0\ud558\ub294 \uac70\uc57c. \uadf8\ub7ec\ub2c8\uae4c \uc2e0\uc18d\ud558\uace0 \uae54\ub054\ud558\uac8c \ucc98\ub9ac\ud558\ub77c\uace0.",
              "maleVariant": "\ub0b4\uac00 \uc758\ub8b0\ud558\ub294 \uac70\uc57c. \uadf8\ub7ec\ub2c8\uae4c \uc2e0\uc18d\ud558\uace0 \uae54\ub054\ud558\uac8c \ucc98\ub9ac\ud558\ub77c\uace0.",
              "stringId": "2436830534246715087"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Listen.",
              "maleVariant": "Listen.",
              "stringId": "3120035173233574268"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\ub108 \ub9d0\uace4 \ubbff\uace0 \ub9e1\uae38 \uc0ac\ub78c\uc774 \uc5c6\uac70\ub4e0.",
              "maleVariant": "\ub108 \ub9d0\uace4 \ubbff\uace0 \ub9e1\uae38 \uc0ac\ub78c\uc774 \uc5c6\uac70\ub4e0.",
              "stringId": "2436832733269971509"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Heh. They didn't even make it out of the car.",
              "maleVariant": "Heh. They didn't even make it out of the car.",
              "stringId": "2779393658226020611"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Shotgun through the glass.",
              "maleVariant": "Shotgun through the glass.",
              "stringId": "2779407951877187354"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Pow!",
              "maleVariant": "Pow!",
              "stringId": "2593271555036156136"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "maleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "stringId": "2779409051388815565"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Ugh!",
              "maleVariant": "Ugh!",
              "stringId": "2790588562204666796"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! Wait! Why?",
              "maleVariant": "No! Wait! Why?",
              "stringId": "2789606698320863598"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Wakako? She hired me!",
              "maleVariant": "Wakako? She hired me!",
              "stringId": "2789607797832491809"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "maleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "stringId": "2789604499297607176"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Look for yourself.",
              "maleVariant": "Look for yourself.",
              "stringId": "2789605598809235387"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Finish it.",
              "maleVariant": "Finish it.",
              "stringId": "2420173659152984664"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Let him go.",
              "maleVariant": "Let him go.",
              "stringId": "2420174758664612875"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Connect.",
              "maleVariant": "Connect.",
              "stringId": "3315287305784286272"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Hand it over.",
              "maleVariant": "Hand it over.",
              "stringId": "3093055499208003535"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nova.",
              "maleVariant": "Nova.",
              "stringId": "2810295193057016356"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Give me half an hour. I'll message you.",
              "maleVariant": "Give me half an hour. I'll message you.",
              "stringId": "2810298491591900989"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Good, you're in. There's a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "maleVariant": "Good, you're in. There's a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "stringId": "3156708257209297834"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Jack in, breach it, and send me everything it's been carrying.",
              "maleVariant": "Jack in, breach it, and send me everything it's been carrying.",
              "stringId": "3155708801139443260"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Share what you found with Wakako.",
              "maleVariant": "Share what you found with Wakako.",
              "stringId": "2396304581542984411"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\uadf8\ub7fc \ub9d0\ud574 \ubd10.",
              "maleVariant": "\uadf8\ub7fc \ub9d0\ud574 \ubd10.",
              "stringId": "2841961933719189729"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Show her Char's trace.",
              "maleVariant": "Show her Char's trace.",
              "stringId": "2395321618147553002"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\ub0b4 \ub9d0 \uc548 \ub4e3\ub294 \ub188\uc740 \uc544\ub2c8\ub2c8\uae4c, \ubb34\uc2a8 \uc77c\uc774 \uc0dd\uae34 \uac70\uaca0\uc9c0.",
              "maleVariant": "\ub0b4 \ub9d0 \uc548 \ub4e3\ub294 \ub188\uc740 \uc544\ub2c8\ub2c8\uae4c, \ubb34\uc2a8 \uc77c\uc774 \uc0dd\uae34 \uac70\uaca0\uc9c0.",
              "stringId": "2841964132742446151"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\uc870\uc6a9\ud558\uba74\uc11c\ub3c4 \uae54\ub054\ud558\uac8c \ub05d\ub0c8\ub124.",
              "maleVariant": "\uc870\uc6a9\ud558\uba74\uc11c\ub3c4 \uae54\ub054\ud558\uac8c \ub05d\ub0c8\ub124.",
              "stringId": "2842954792719275037"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\ub4e4\uc5b4\uac14\ub2e4 \ube60\uc838\ub098\uc624\ub294 \uc19c\uc528\uac00 \uc544\uc8fc \uadc0\uc2e0\uc778\ub370, V.",
              "maleVariant": "\ub4e4\uc5b4\uac14\ub2e4 \ube60\uc838\ub098\uc624\ub294 \uc19c\uc528\uac00 \uc544\uc8fc \uadc0\uc2e0\uc778\ub370, V.",
              "stringId": "3423925640042202332"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\uc870\uc6a9\ud788 \ucc98\ub9ac\ud558\ub77c\uace0 \ud588\uc744 \ud150\ub370, \uc804\ud600 \uc548 \uc870\uc6a9\ud588\uc5b4.",
              "maleVariant": "\uc870\uc6a9\ud788 \ucc98\ub9ac\ud558\ub77c\uace0 \ud588\uc744 \ud150\ub370, \uc804\ud600 \uc548 \uc870\uc6a9\ud588\uc5b4.",
              "stringId": "3408739870859945416"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Lean on the railing and wait for Char.",
              "maleVariant": "Lean on the railing and wait for Char.",
              "stringId": "3327307582760467917"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Sit down and wait for Char.",
              "maleVariant": "Sit down and wait for Char.",
              "stringId": "2623302448557323786"
            }
          ]
        }
