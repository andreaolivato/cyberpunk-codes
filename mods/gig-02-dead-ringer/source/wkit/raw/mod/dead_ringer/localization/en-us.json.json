              "primaryKey": "0",
              "secondaryKey": "cc-g02-obj-decide"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Read the messages on his shard",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g02-obj-proof"
            },
            {
