            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Communication shard",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g02-shard-item"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Pulled off a merc outside Afterlife. Two threads on it, both signed with Wakako Okada's tag.",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g02-shard-item-desc"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "COMMS RECORD // AUTH: OKADA-W",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g02-shard-title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "CHANNEL: contract-relay/wbr-jpn-04\nAUTH TAG: OKADA-W (verified)\nPARTY: [redacted] (contractor)\n\n[ 22:41:07 ] OKADA-W >> contractor\nThe matter in Jig-Jig Street is approved.\nProceed as discussed. Keep collateral minimal.\nPayment will be transferred on completion\n\n[ 03:12:55 ] OKADA-W >> contractor\nProof received.\nFunds are in your account.\nArrangement concluded.\n\nTRANSFER: 8,000 ED, ref 4C-77-KO, cleared 03:13:02\nORIGIN ACCOUNT: Okada holdings, Japantown\nSIGNATURE CHECK: PASS",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g02-shard-body"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Seen. This will not stay quiet now.",
