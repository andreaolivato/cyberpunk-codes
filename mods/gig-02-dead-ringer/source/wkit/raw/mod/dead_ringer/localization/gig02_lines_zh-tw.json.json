        "Data": {
          "$type": "localizationPersistenceSubtitleEntries",
          "entries": [
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u6211\u9700\u8981\u53ef\u4ee5\u5feb\u901f\u53c8\u4f4e\u8abf\u5b8c\u6210\u4efb\u52d9\u7684\u4eba\uff0c\u5230\u4e00\u500b\u6212\u5099\u68ee\u56b4\u7684\u5730\u65b9\u88dd\u7aca\u807d\u5668\u3002",
              "maleVariant": "\u6211\u9700\u8981\u53ef\u4ee5\u5feb\u901f\u53c8\u4f4e\u8abf\u5b8c\u6210\u4efb\u52d9\u7684\u4eba\uff0c\u5230\u4e00\u500b\u6212\u5099\u68ee\u56b4\u7684\u5730\u65b9\u88dd\u7aca\u807d\u5668\u3002",
              "stringId": "2436829434735086876"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u9019\u662f\u6211\u500b\u4eba\u7684\u59d4\u8a17\uff0c\u6c92\u6709\u5ba2\u6236\uff0c\u6240\u4ee5\u6211\u5e0c\u671b\u4f60\u4fd0\u843d\u641e\u5b9a\u3002",
              "maleVariant": "\u9019\u662f\u6211\u500b\u4eba\u7684\u59d4\u8a17\uff0c\u6c92\u6709\u5ba2\u6236\uff0c\u6240\u4ee5\u6211\u5e0c\u671b\u4f60\u4fd0\u843d\u641e\u5b9a\u3002",
              "stringId": "2436830534246715087"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Listen.",
              "maleVariant": "Listen.",
              "stringId": "3120035173233574268"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u9019\u6848\u5b50\u6211\u53ea\u653e\u5fc3\u4ea4\u7d66\u4f60\u8655\u7406\u3002",
              "maleVariant": "\u9019\u6848\u5b50\u6211\u53ea\u653e\u5fc3\u4ea4\u7d66\u4f60\u8655\u7406\u3002",
              "stringId": "2436832733269971509"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Heh. They didn't even make it out of the car.",
              "maleVariant": "Heh. They didn't even make it out of the car.",
              "stringId": "2779393658226020611"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Shotgun through the glass.",
              "maleVariant": "Shotgun through the glass.",
              "stringId": "2779407951877187354"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Pow!",
              "maleVariant": "Pow!",
              "stringId": "2593271555036156136"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "maleVariant": "Over before anyone on Jig-Jig Street could even scream.",
              "stringId": "2779409051388815565"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Ugh!",
              "maleVariant": "Ugh!",
              "stringId": "2790588562204666796"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! Wait! Why?",
              "maleVariant": "No! Wait! Why?",
              "stringId": "2789606698320863598"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Wakako? She hired me!",
              "maleVariant": "Wakako? She hired me!",
              "stringId": "2789607797832491809"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "maleVariant": "No! I got the messages. Her tag, her words, the transfer. Take it. Read it.",
              "stringId": "2789604499297607176"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Look for yourself.",
              "maleVariant": "Look for yourself.",
              "stringId": "2789605598809235387"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Finish it.",
              "maleVariant": "Finish it.",
              "stringId": "2420173659152984664"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Let him go.",
              "maleVariant": "Let him go.",
              "stringId": "2420174758664612875"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Connect.",
              "maleVariant": "Connect.",
              "stringId": "3315287305784286272"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Hand it over.",
              "maleVariant": "Hand it over.",
              "stringId": "3093055499208003535"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Nova.",
              "maleVariant": "Nova.",
              "stringId": "2810295193057016356"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Give me half an hour. I'll message you.",
              "maleVariant": "Give me half an hour. I'll message you.",
              "stringId": "2810298491591900989"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Good, you're in. There's a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "maleVariant": "Good, you're in. There's a hardline access point on the wall at the back. Whatever sent those orders went through it.",
              "stringId": "3156708257209297834"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Jack in, breach it, and send me everything it's been carrying.",
              "maleVariant": "Jack in, breach it, and send me everything it's been carrying.",
              "stringId": "3155708801139443260"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Share what you found with Wakako.",
              "maleVariant": "Share what you found with Wakako.",
              "stringId": "2396304581542984411"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u90a3\u4f60\u8aaa\u5427\uff0c\u800c\u4e14\u5225\u5fd8\u4e86\u6211\u96a8\u6642\u53ef\u4ee5\u6253\u96fb\u8a71\u3002",
              "maleVariant": "\u90a3\u4f60\u8aaa\u5427\uff0c\u800c\u4e14\u5225\u5fd8\u4e86\u6211\u96a8\u6642\u53ef\u4ee5\u6253\u96fb\u8a71\u3002",
              "stringId": "2841961933719189729"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Show her Char's trace.",
              "maleVariant": "Show her Char's trace.",
              "stringId": "2395321618147553002"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u4ed6\u4e00\u5b9a\u51fa\u4e8b\u4e86\uff0c\u56e0\u70ba\u4ed6\u6c92\u81bd\u9055\u6297\u6211\u7684\u6307\u4ee4\u3002 \u770b\u770b\u8cc7\u6599\uff0c\u8fc5\u901f\u89e3\u6c7a\u9019\u500b\u72c0\u6cc1\uff0c\u6211\u9700\u8981\u90a3\u500b\u7ac4\u7db2\u4f7f\u3002",
              "maleVariant": "\u4ed6\u4e00\u5b9a\u51fa\u4e8b\u4e86\uff0c\u56e0\u70ba\u4ed6\u6c92\u81bd\u9055\u6297\u6211\u7684\u6307\u4ee4\u3002 \u770b\u770b\u8cc7\u6599\uff0c\u8fc5\u901f\u89e3\u6c7a\u9019\u500b\u72c0\u6cc1\uff0c\u6211\u9700\u8981\u90a3\u500b\u7ac4\u7db2\u4f7f\u3002",
              "stringId": "2841964132742446151"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u4f4e\u8abf\u5de7\u5999\uff0c\u4e0d\u904e\u9019\u56db\u500b\u5b57\u7121\u6cd5\u62ff\u4f86\u5f62\u5bb9\u53e4\u9435\u96f7\u65af\u5148\u751f\u7684\u96e2\u5a5a\u72c0\u6cc1\u3002",
              "maleVariant": "\u4f4e\u8abf\u5de7\u5999\uff0c\u4e0d\u904e\u9019\u56db\u500b\u5b57\u7121\u6cd5\u62ff\u4f86\u5f62\u5bb9\u53e4\u9435\u96f7\u65af\u5148\u751f\u7684\u96e2\u5a5a\u72c0\u6cc1\u3002",
              "stringId": "2842954792719275037"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u4f60\u7684\u884c\u52d5\u795e\u4e0d\u77e5\u9b3c\u4e0d\u89ba\uff0cV\u3002",
              "maleVariant": "\u4f60\u7684\u884c\u52d5\u795e\u4e0d\u77e5\u9b3c\u4e0d\u89ba\uff0cV\u3002",
              "stringId": "3423925640042202332"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "\u6211\u8981\u4f60\u795e\u4e0d\u77e5\u9b3c\u4e0d\u89ba\uff0c\u7d50\u679c\u4f60\u53cd\u8457\u4f86\u3002 \u5168\u591c\u57ce\u90fd\u77e5\u9053\u795e\u793e\u51fa\u4e86\u4ec0\u9ebc\u4e8b\u3002",
              "maleVariant": "\u6211\u8981\u4f60\u795e\u4e0d\u77e5\u9b3c\u4e0d\u89ba\uff0c\u7d50\u679c\u4f60\u53cd\u8457\u4f86\u3002 \u5168\u591c\u57ce\u90fd\u77e5\u9053\u795e\u793e\u51fa\u4e86\u4ec0\u9ebc\u4e8b\u3002",
              "stringId": "3408739870859945416"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Lean on the railing and wait for Char.",
              "maleVariant": "Lean on the railing and wait for Char.",
              "stringId": "3327307582760467917"
            },
            {
              "$type": "localizationPersistenceSubtitleEntry",
              "femaleVariant": "Sit down and wait for Char.",
              "maleVariant": "Sit down and wait for Char.",
              "stringId": "2623302448557323786"
            }
          ]
        }
      }
    },
