    private static func Nearest(x: Float, y: Float, xs: array<Float>, ys: array<Float>,
                                left: array<Float>) -> Float {
        let best: Float = -1.0;
        let at: Float = 0.0;
        let k: Int32 = 0;
        while k < ArraySize(xs) {
            let dx: Float = xs[k] - x;
            let dy: Float = ys[k] - y;
            let d: Float = dx * dx + dy * dy;
            if best < 0.0 || d < best {
                best = d;
                at = left[k];
            }
            k += 1;
        }
        return at;
    }
