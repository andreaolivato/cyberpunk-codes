              "femaleVariant": "Read the message from Nix",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-obj-nixread"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Get to the Arasaka estate in North Oak",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-obj-estate"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Find a way into the residence",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-obj-wayin"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Find Hoshino",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-obj-hoshino"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Take Hoshino out",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-obj-kill"
