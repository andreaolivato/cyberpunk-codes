              "primaryKey": "0",
              "secondaryKey": "cc-g01-obj-disconnect"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Get clear of the compound",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "cc-g01-obj-nix"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Call Nix",
